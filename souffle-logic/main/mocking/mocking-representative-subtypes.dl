// ===========================================================================
// mocking-representative-subtypes.dl -- REPRESENTATIVE mocking policy.
//
// To stand in for a (non-universal, non-array) type, create a mock of ONE
// eligible concrete class of it -- the first by name (TypeRank), so the choice
// does not depend on the engine (eligibility defined in mocking-core.dl).
// Core wires the mock in.
// ===========================================================================

#include "mocking-core.dl"

.decl RepresentativeImplRank(?type:ReferenceType, ?classRank:number)
RepresentativeImplRank(?type, ?classRank) :-
  EligibleConcreteImpl(_, ?type),
  ?classRank = min ?r : { EligibleConcreteImpl(?c, ?type), TypeRank(?c, ?r) }.

MOCK_OBJECT_FOR_TYPE(?value, ?class, ?type) :-
  MockSiteType(?type),
  RepresentativeImplRank(?type, ?classRank),
  TypeRank(?class, ?classRank),
  isClassType(?class),
  !RefinedClass(?class),            // refined classes are represented per-instance (jackee)
  ?value = MOCK_OBJECT_OF_TYPE(?class).
