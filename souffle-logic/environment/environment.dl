// ==========================================================================
// Environment
//
// Models how external frameworks and libraries interact with the
// application program (e.g. object creation, entry points, injection and taint).
// Engines include this file and read only the contract interface.
//
//                     facts/ + basic/ + shortcuts
//                                   │
//        ┌──────────────┬───────────┴───┬───────────────────┐
//        ▼              ▼               ▼                   ▼
//    jakarta-*     spring-data     spring (own)        direct files
//    (@Inject,     spring-xml      (@Component,        (servlet, JPA, REST,
//     @Resource,   (repos, *Impl,   @Autowired,         validation, WebSocket,
//     listeners)    XML beans)      FactoryBean)        interceptors, web,
//                                                       security, AOP, JUnit)
//        │              │               │                   │
//        └──────────────┼───────────────┘                   │
//                       ▼                                   │
//           ┌───────────────────────┐                       │
//           │       handoffs        │                       │
//           │ (accumulated context) │                       │
//           └───────────┬───────────┘                       │
//                       ▼                                   │
//                 DI containers                             │
//             (choosing, may negate)                        │
//                       └─────────────────┬─────────────────┘
//                                         ▼
//                             ┌──────────────────────┐
//                             │  contract interface  │  (+ auto rules)
//                             └──────────┬───────────┘
//                                   ┌────┴────┐
//                                   ▼         ▼
//                               points-to  taint / ...
//
// Layout:
//   contracts.dl     Shared relations: the contract interface (creation, entry, injection:
//                    finished facts engines act on, with their auto rules) and the handoffs
//                    (internal relations between specs and frameworks for facts one file
//                    cannot finish alone, e.g. @Inject).
//   annotations.dl   Annotation chains and values, and EnvironmentAnnotation.
//   constructors.dl, members.dl, generics.dl, names.dl
//                    Shared shortcuts over facts/ and basic/.
//   specs/       Published standards (e.g. Jakarta) shared by all their
//                implementations (e.g. Hibernate).
//   frameworks/  Framework specific rules (e.g. spring.dl), grouped in
//                subfolders when large (e.g. frameworks/spring/).
//
// Specs and frameworks dont read each other directly: they communicate through
// handoffs, never read from the contract interface and never negate shared
// relations, so DI containers can safely use negation when choosing without breaking
// stratification.
// ==========================================================================



// The name of each spec or framework.
// Every tuple in the shared relations starts with its owner.
// On the contract interface it is the framework that acts;
// on a handoff it is the one that makes it.
.decl Owner(?name:symbol)

// Tuples the contract checks report as wrong, with their owner.
// The checks list such tuples in the output (ContractProblem.csv) without failing,
// so mistakes in spec and framework rules are visible.
.decl ContractProblem(?owner:symbol, ?relation:symbol, ?value:symbol, ?problem:symbol)
.output ContractProblem

// Reports the tuples of a shared relation whose owner is not declared.
// ?owner must be named in args; value is the column the report shows.
// e.g. CONTRACT_OWNER_CHECK(InjectedWith, ?slot, (?owner, _, ?slot, _))
#define CONTRACT_OWNER_CHECK(relation, value, args) \
  ContractProblem(?owner, #relation, value, "Owner not declared") :- \
    relation args, \
    !Owner(?owner).



// --- Contracts ---
#include "contracts.dl"



// --- Helpers ---
#include "annotations.dl"
#include "constructors.dl"
#include "members.dl"
#include "generics.dl"
#include "names.dl"



// --- Specs ---
// Including a spec activates it.
#include "specs/jakarta/jakarta-inject.dl"
#include "specs/jakarta/jakarta-annotation.dl"
#include "specs/jakarta/jakarta-servlet.dl"
#include "specs/jakarta/jakarta-persistence.dl"
#include "specs/jakarta/jakarta-rest.dl"
#include "specs/jakarta/jakarta-validation.dl"
#include "specs/jakarta/jakarta-websocket.dl"
#include "specs/jakarta/jakarta-interceptors.dl"



// --- Frameworks ---
// Including a framework activates it.
#include "frameworks/spring/spring.dl"
#include "frameworks/spring/spring-web.dl"
#include "frameworks/spring/spring-boot.dl"
#include "frameworks/spring/spring-data.dl"
#include "frameworks/spring/spring-security.dl"
#include "frameworks/spring/spring-aop.dl"
#include "frameworks/spring/spring-messaging.dl"
#include "frameworks/spring/spring-xml.dl"
#include "frameworks/junit.dl"
