// ==========================================================================
// Names helper:
//
// Java and JavaBeans naming rules (Introspector.decapitalize):
// type names without their package (binary and dotted), decapitalized type names, setter property names
// and the jakarta/javax names of Jakarta EE APIs.
// ==========================================================================




// --------------------------------------------------------------------------
// Decapitalization (internal)
// --------------------------------------------------------------------------

.decl _Names_Lower(?upper:symbol, ?lower:symbol)
_Names_Lower("A", "a"). _Names_Lower("B", "b"). _Names_Lower("C", "c"). _Names_Lower("D", "d").
_Names_Lower("E", "e"). _Names_Lower("F", "f"). _Names_Lower("G", "g"). _Names_Lower("H", "h").
_Names_Lower("I", "i"). _Names_Lower("J", "j"). _Names_Lower("K", "k"). _Names_Lower("L", "l").
_Names_Lower("M", "m"). _Names_Lower("N", "n"). _Names_Lower("O", "o"). _Names_Lower("P", "p").
_Names_Lower("Q", "q"). _Names_Lower("R", "r"). _Names_Lower("S", "s"). _Names_Lower("T", "t").
_Names_Lower("U", "u"). _Names_Lower("V", "v"). _Names_Lower("W", "w"). _Names_Lower("X", "x").
_Names_Lower("Y", "y"). _Names_Lower("Z", "z").

// Inputs fed into JavaBeans decapitalization (kept small: application classes and setters).
.decl _Names_DecapInput(?raw:symbol)
.decl _Names_Decapitalize(?raw:symbol, ?decap:symbol)

// First two letters uppercase -> unchanged (e.g. URLParser -> URLParser).
_Names_Decapitalize(?raw, ?raw) :-
  _Names_DecapInput(?raw),
  strlen(?raw) > 1,
  _Names_Lower(substr(?raw, 0, 1), _),
  _Names_Lower(substr(?raw, 1, 1), _).

// First letter uppercase, second not (or length 1) -> lowercase first letter.
_Names_Decapitalize(?raw, ?decap) :-
  _Names_DecapInput(?raw),
  strlen(?raw) > 0,
  _Names_Lower(substr(?raw, 0, 1), ?lo),
  ( strlen(?raw) = 1 ; !_Names_Lower(substr(?raw, 1, 1), _) ),
  ?decap = cat(?lo, substr(?raw, 1, strlen(?raw) - 1)).

// First letter not uppercase (or empty) -> unchanged.
_Names_Decapitalize(?raw, ?raw) :-
  _Names_DecapInput(?raw),
  ( strlen(?raw) = 0 ; !_Names_Lower(substr(?raw, 0, 1), _) ).




// --------------------------------------------------------------------------
// Type names (application classes and interfaces)
// --------------------------------------------------------------------------

// Scans an application class name backwards from its last character and stops at the
// first dot; the scan reaches position 0 only when the name has no package.
.decl _Names_Scan(?type:ReferenceType, ?pos:number)

_Names_Scan(?type, strlen(?type) - 1) :-
  ApplicationClass(?type),
  isClassOrInterfaceType(?type),
  strlen(?type) > 0.

_Names_Scan(?type, ?pos - 1) :-
  _Names_Scan(?type, ?pos),
  ?pos > 0,
  substr(?type, ?pos, 1) != ".".


// The name of an application class or interface without its package (everything after the last dot,
// or the whole name), as the class file has it: a nested class keeps its outer class and the $,
// unlike Class.getSimpleName (DottedTypeNameWithoutPackage gives the source form).
// Java: com.example.OrderService -> OrderService, com.example.Outer$Inner -> Outer$Inner
// Spring Data: matching *Impl class names
.decl TypeNameWithoutPackage(?type:ReferenceType, ?name:symbol)

TypeNameWithoutPackage(?type, ?name) :-
  _Names_Scan(?type, ?pos),
  substr(?type, ?pos, 1) = ".",
  ?name = substr(?type, ?pos + 1, strlen(?type) - ?pos - 1).

TypeNameWithoutPackage(?type, ?type) :-
  _Names_Scan(?type, 0),
  substr(?type, 0, 1) != ".".

// Rebuilds a name without its package that has a $, one character at a time, with a dot for each $
// (Souffle has no string replace). ?prefix is the rebuilt name up to ?pos.
.decl _Names_DollarToDot(?type:ReferenceType, ?pos:number, ?prefix:symbol)

_Names_DollarToDot(?type, 0, "") :-
  TypeNameWithoutPackage(?type, ?name),
  contains("$", ?name).

_Names_DollarToDot(?type, ?pos + 1, cat(?prefix, ?char)) :-
  _Names_DollarToDot(?type, ?pos, ?prefix),
  TypeNameWithoutPackage(?type, ?name),
  ?pos < strlen(?name),
  ?char = substr(?name, ?pos, 1),
  ?char != "$".

_Names_DollarToDot(?type, ?pos + 1, cat(?prefix, ".")) :-
  _Names_DollarToDot(?type, ?pos, ?prefix),
  TypeNameWithoutPackage(?type, ?name),
  ?pos < strlen(?name),
  substr(?name, ?pos, 1) = "$".


// The name of an application class or interface without its package, with a dot between
// a nested class and its outer class, as in Java source code (every $ becomes a dot).
// Java: com.example.OrderService -> OrderService, com.example.Outer$Inner -> Outer.Inner
// Spring: ClassUtils.getShortName, the base of default bean names
.decl DottedTypeNameWithoutPackage(?type:ReferenceType, ?name:symbol)

DottedTypeNameWithoutPackage(?type, ?name) :-
  TypeNameWithoutPackage(?type, ?binary),
  !contains("$", ?binary),
  ?name = ?binary.

DottedTypeNameWithoutPackage(?type, ?name) :-
  TypeNameWithoutPackage(?type, ?binary),
  _Names_DollarToDot(?type, strlen(?binary), ?name).

_Names_DecapInput(?simple) :- DottedTypeNameWithoutPackage(_, ?simple).


// The JavaBeans decapitalized name of an application class or interface, without its package
// and with dots for nested classes (DottedTypeNameWithoutPackage).
// Spring: default @Component bean name (OrderService -> orderService, URLParser -> URLParser,
//         Outer$Inner -> outer.Inner; AnnotationBeanNameGenerator.buildDefaultBeanName)
// Spring Data: default repository bean name (OrderRepository -> orderRepository)
// Not CDI's default bean name, which lowercases only the first character (URLParser -> uRLParser).
.decl DecapitalizedTypeName(?type:ReferenceType, ?name:symbol)

DecapitalizedTypeName(?type, ?name) :-
  DottedTypeNameWithoutPackage(?type, ?simple),
  _Names_Decapitalize(?simple, ?name).




// --------------------------------------------------------------------------
// Setter property names
// --------------------------------------------------------------------------

.decl _Names_SetterSuffix(?method:Method, ?raw:symbol)

_Names_SetterSuffix(?method, ?raw) :-
  !Method_Modifier("static", ?method),
  !ConstructorOf(?method, _),
  FormalParam(0, ?method, _),
  !FormalParam(1, ?method, _),
  Method_SimpleName(?method, ?mname),
  strlen(?mname) > 3,
  substr(?mname, 0, 3) = "set",
  ?raw = substr(?mname, 3, strlen(?mname) - 3).

_Names_DecapInput(?raw) :- _Names_SetterSuffix(_, ?raw).


// The JavaBeans property name of a non-static single-parameter setter (setFoo -> foo, setURL -> URL).
// Spring: default @Resource setter bean name
// Jakarta: JPA property access
.decl SetterPropertyName(?method:Method, ?name:symbol)

SetterPropertyName(?method, ?name) :-
  _Names_SetterSuffix(?method, ?raw),
  _Names_Decapitalize(?raw, ?name).




// --------------------------------------------------------------------------
// Jakarta EE names
// --------------------------------------------------------------------------

// Both names of a Jakarta EE API type or annotation: jakarta.<suffix> and javax.<suffix>.
// An API that only exists as jakarta also gets a javax name that matches nothing.
// Jakarta: JakartaOrJavaxName("inject.Inject", ?name) gives jakarta.inject.Inject and javax.inject.Inject
.decl JakartaOrJavaxName(?suffix:symbol, ?name:symbol) inline

JakartaOrJavaxName(?suffix, cat("jakarta.", ?suffix)) :- true.
JakartaOrJavaxName(?suffix, cat("javax.", ?suffix)) :- true.
