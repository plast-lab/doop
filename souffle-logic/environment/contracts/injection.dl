// ==========================================================================
// Injection (contract interface):
//
// Classes the framework injects into, the fields and parameters it fills
// and what it fills them with.
// ==========================================================================



// A field or a parameter the framework fills.
// A parameter is its variable from FormalParam.
.type Slot = Field | Var

// What can go into a slot: a class or interface, a method or a field (see InjectedWith).
.type Source = Type | Method | Field







// --------------------------------------------------------------------------
// Relations
// --------------------------------------------------------------------------

// A class whose objects get injected: the framework fills their injected fields and parameters.
// It's separate from FrameworkCreatedType since a framework may inject into objects
// it didn't create (e.g. Spring into the test classes JUnit creates) and may create
// objects it never injects into (e.g. JPA entities).
// The engine fills the injected slots only in objects of these classes and
// also in the ones the program creates (e.g. objects returned from Spring @Bean methods).
// It doesn't mean the class is put into slots, that's InjectedWith.
// It may be abstract when the framework subclasses it at runtime (e.g. a Spring bean
// with @Lookup methods).
// Spring: @Component classes, @SpringBootTest classes
// Jakarta: JPA entity listeners (not entities)
.decl InjectionTarget(?owner:symbol, ?class:ClassType)


// A field the framework fills, in the objects of the injection targets that have it.
// Added by the contract from SlotInjectionRequest, InjectedWith and HolderInjectedWith; written directly for
// slots driven by one injector's own rules (e.g. Spring XML <property>).
// Spring: XML <property> (direct); @Autowired (via SlotInjectionRequest)
// Jakarta: @Inject, @Resource (via SlotInjectionRequest)
.decl InjectedField(?owner:symbol, ?field:Field)


// A parameter the framework fills with one of its objects.
// Added by the contract from SlotInjectionRequest, InjectedWith and HolderInjectedWith; written directly for
// slots driven by one injector's own rules (e.g. chosen constructor, @Bean, @Produces).
// Spring: chosen constructor, @Bean methods (direct); @Autowired setters (via SlotInjectionRequest)
// Jakarta: @Produces methods (direct); @Inject constructors and methods (via SlotInjectionRequest)
.decl InjectedParam(?owner:symbol, ?param:Var)


// What the framework may put into a slot in the objects of a class it injects into,
// after its own resolution logic (types, qualifiers, @Primary etc..).
// The class is needed since a field declared once lives in the objects of every subclass
// and may get something else in each (e.g. Spring uses generics as qualifiers,
// so BaseService<R>.repo gets OwnerRepository in OwnerService and PetRepository in PetService).
// Several tuples for one slot mean any of them.
// Sources are:
//   class or interface: the mock object the engine made for it (FrameworkCreatedType)
//   method:             what the method returns when the framework calls it
//   field:              the value of that field
// A slot without tuples gets a mock of its type.
.decl InjectedWith(?owner:symbol, ?class:ClassType, ?slot:Slot, ?source:Source)


// What the framework puts inside a holder slot (collection, map, array or wrapper).
// The holder's type is the slot's own type.
// Separate from InjectedWith because:
//   - InjectedWith assigns the source directly to the slot (slot = source), whereas
//     HolderInjectedWith puts the source inside a holder (slot = Holder(source)),
//     so a direct List bean and the elements inside a List cant be mixed up.
//   - Several InjectedWith tuples mean "any one of them", while for collections, maps and arrays
//     several HolderInjectedWith tuples are all in the holder together.
// Spring: @Autowired List<Gateway>, Optional<Gateway>, ObjectProvider<Gateway>
// Jakarta: @Inject Provider<Clock>
.decl HolderInjectedWith(?owner:symbol, ?class:ClassType, ?slot:Slot, ?source:Source)







// --------------------------------------------------------------------------
// Tuples the contract adds
// --------------------------------------------------------------------------
// Always true when another tuple exists, whatever the framework, so specs and frameworks
// don't need to repeat or ever forget them. Each belongs to the owner of the tuple it follows from
// (for a request its whoever injects into the object).


// A field or parameter with an InjectedWith or HolderInjectedWith tuple is injected.
InjectedField(?owner, ?slot) :-
  ( InjectedWith(?owner, _, ?slot, _)
  ; HolderInjectedWith(?owner, _, ?slot, _) ),
  isField(?slot).

InjectedParam(?owner, ?slot) :-
  ( InjectedWith(?owner, _, ?slot, _)
  ; HolderInjectedWith(?owner, _, ?slot, _) ),
  isVar(?slot).


// Whoever injects into an object fills the fields and parameters the program asked for
// (SlotInjectionRequest, e.g. @Inject), whichever spec or framework wrote the request.
// The tuple is the injecting framework's, the request only says why.
InjectedField(?framework, ?field) :-
  InjectionTarget(?framework, ?class),
  FieldOf(?field, ?class),
  SlotInjectionRequest(_, ?field).

InjectedParam(?framework, ?param) :-
  InjectionTarget(?framework, ?class),
  ParamOf(?param, ?class),
  SlotInjectionRequest(_, ?param).

// Constructor parameters only when the framework also creates the object,
// since it doesn't call the constructor of objects the program creates (e.g. Spring @Bean results).
InjectedParam(?framework, ?param) :-
  InjectionTarget(?framework, ?class),
  FrameworkCreatedType(?framework, ?class),
  ConstructorOf(?ctor, ?class),
  FormalParam(_, ?ctor, ?param),
  SlotInjectionRequest(_, ?param).







// --------------------------------------------------------------------------
// Checks
// --------------------------------------------------------------------------

ContractProblem(?owner, "InjectionTarget", ?class, "Owner not declared") :-
  InjectionTarget(?owner, ?class),
  !Owner(?owner).

ContractProblem(?owner, "InjectedField", ?field, "Owner not declared") :-
  InjectedField(?owner, ?field),
  !Owner(?owner).

ContractProblem(?owner, "InjectedParam", ?param, "Owner not declared") :-
  InjectedParam(?owner, ?param),
  !Owner(?owner).

ContractProblem(?owner, "InjectedWith", ?slot, "Owner not declared") :-
  InjectedWith(?owner, _, ?slot, _),
  !Owner(?owner).

ContractProblem(?owner, "HolderInjectedWith", ?slot, "Owner not declared") :-
  HolderInjectedWith(?owner, _, ?slot, _),
  !Owner(?owner).


ContractProblem(?owner, "InjectionTarget", ?class, "Not a class") :-
  InjectionTarget(?owner, ?class),
  !isClassType(?class).

ContractProblem(?owner, "InjectedField", ?field, "Not a field") :-
  InjectedField(?owner, ?field),
  !isField(?field).

ContractProblem(?owner, "InjectedParam", ?param, "Not a formal parameter") :-
  InjectedParam(?owner, ?param),
  !FormalParam(_, _, ?param).

ContractProblem(?owner, "InjectedWith", ?source, "Source is not a class, interface, method or field") :-
  InjectedWith(?owner, _, _, ?source),
  !isClassType(?source),
  !isInterfaceType(?source),
  !isMethod(?source),
  !isField(?source).

ContractProblem(?owner, "HolderInjectedWith", ?source, "Source is not a class, interface, method or field") :-
  HolderInjectedWith(?owner, _, _, ?source),
  !isClassType(?source),
  !isInterfaceType(?source),
  !isMethod(?source),
  !isField(?source).

// An object of the class or interface must fit the type of the slot.
// Only class and interface sources, since a method may declare a wider return type
// (e.g. Object) and still return the right object.
// Types missing from the facts can also show up here.
ContractProblem(?owner, "InjectedWith", ?source, "Class or interface does not fit the type of the slot") :-
  InjectedWith(?owner, _, ?slot, ?source),
  ( isClassType(?source) ; isInterfaceType(?source) ),
  SlotType(?slot, ?type),
  !basic.SubtypeOf(?source, ?type).

// A primitive slot (int, boolean...) can never be a holder.
ContractProblem(?owner, "HolderInjectedWith", ?slot, "Holder slot is not a reference type") :-
  HolderInjectedWith(?owner, _, ?slot, _),
  SlotType(?slot, ?type),
  !isReferenceType(?type).

// For array slots, a class or interface source must fit the array's component type.
ContractProblem(?owner, "HolderInjectedWith", ?source, "Class or interface does not fit the array element type") :-
  HolderInjectedWith(?owner, _, ?slot, ?source),
  ( isClassType(?source) ; isInterfaceType(?source) ),
  SlotType(?slot, ?arrType),
  ComponentType(?arrType, ?elemType),
  !basic.SubtypeOf(?source, ?elemType).


// A spec or framework says what goes into the slots only of the classes it injects into
// (its own InjectionTarget), so it never decides for the objects of another framework.
// Static fields belong to no object, so a file may fill one without injecting into
// objects of its class (e.g. Guice requestStaticInjection).
ContractProblem(?owner, "InjectedWith", ?class, "Class is not one this file injects into") :-
  InjectedWith(?owner, ?class, ?slot, _),
  !InjectionTarget(?owner, ?class),
  !Field_Modifier("static", ?slot).

ContractProblem(?owner, "InjectedWith", ?slot, "Slot is not in the class") :-
  InjectedWith(?owner, ?class, ?slot, _),
  !SlotOf(?slot, ?class).

ContractProblem(?owner, "HolderInjectedWith", ?class, "Class is not one this file injects into") :-
  HolderInjectedWith(?owner, ?class, ?slot, _),
  !InjectionTarget(?owner, ?class),
  !Field_Modifier("static", ?slot).

ContractProblem(?owner, "HolderInjectedWith", ?slot, "Slot is not in the class") :-
  HolderInjectedWith(?owner, ?class, ?slot, _),
  !SlotOf(?slot, ?class).
