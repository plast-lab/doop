// ==========================================================================
// Requests and offers (internal to environment/):
//
// What spec and framework files tell each other, so each file keeps only
// what it knows and never reads another file. Engines never read these
// relations, and rules writing them never read from the contract interface.
// A request asks whoever plays a role (e.g. whoever injects into the object)
// to do something, an offer gives objects to whoever hands them out.
// A tuple nobody reads changes nothing (e.g. @Inject in an application without a DI framework).
// ==========================================================================




// --------------------------------------------------------------------------
// Requests
// --------------------------------------------------------------------------

// The program asks for this field or parameter to be injected by whoever injects into its object.
// The contract turns it into InjectedField / InjectedParam on every InjectionTarget (injection.dl).
// Spring: @Autowired
// Jakarta: @Inject, @Resource
.decl SlotInjectionRequest(?owner:symbol, ?slot:Slot)


// The program asks for this DI callback method to be called by whoever injects into its object.
// The contract turns it into EntryPoint on every InjectionTarget (entry.dl).
// Jakarta: @PostConstruct, @PreDestroy
.decl DICallbackRequest(?owner:symbol, ?method:Method)


// A spec or library asks the active DI framework to create objects of this class and inject into them
// (the DI framework marks the class FrameworkCreatedType and InjectionTarget, without offering it to others).
// Unlike writing FrameworkCreatedType directly (e.g. for a JPA @Entity that never gets injected),
// this delegates creation to DI so constructor/field injection and callbacks all run on it.
// Spring Data: custom repository implementations (OwnerRepositoryImpl)
// Jakarta: JPA entity listeners, Bean Validation ConstraintValidators, servlets
.decl DICreationRequest(?owner:symbol, ?class:ClassType)




// --------------------------------------------------------------------------
// Offers
// --------------------------------------------------------------------------

// Objects from this source are available to whoever hands out objects
// (into the slots they fit).
// Sources are the same as in InjectedWith (class or interface, method, field).
// Each reader picks from them with its own rules (Spring calls them autowire candidates,
// but drops some that are still injected by name, so offers are all of them).
// Spring: its beans
// Spring Data: repositories
.decl InjectionOffer(?owner:symbol, ?source:Source)


// A name/alias for an offered source above.
// It's optional and it can be multi-valued: an offer may have no name, one name or several.
// Framework/specs use these names for name-based lookup (e.g. @Resource, @Qualifier).
// Spring: bean names and @Bean aliases
// Spring Data: decapitalized repository interface names (or @Repository("..."))
.decl InjectionOfferName(?owner:symbol, ?source:Source, ?name:symbol)




// --------------------------------------------------------------------------
// Checks
// --------------------------------------------------------------------------

ContractProblem(?owner, "SlotInjectionRequest", ?slot, "Owner not declared") :-
  SlotInjectionRequest(?owner, ?slot),
  !Owner(?owner).

ContractProblem(?owner, "DICallbackRequest", ?method, "Owner not declared") :-
  DICallbackRequest(?owner, ?method),
  !Owner(?owner).

ContractProblem(?owner, "DICreationRequest", ?class, "Owner not declared") :-
  DICreationRequest(?owner, ?class),
  !Owner(?owner).

ContractProblem(?owner, "InjectionOffer", ?source, "Owner not declared") :-
  InjectionOffer(?owner, ?source),
  !Owner(?owner).

ContractProblem(?owner, "InjectionOfferName", ?source, "Owner not declared") :-
  InjectionOfferName(?owner, ?source, _),
  !Owner(?owner).


ContractProblem(?owner, "SlotInjectionRequest", ?slot, "Not a field or formal parameter") :-
  SlotInjectionRequest(?owner, ?slot),
  !isField(?slot),
  !FormalParam(_, _, ?slot).

ContractProblem(?owner, "DICallbackRequest", ?method, "Not a method") :-
  DICallbackRequest(?owner, ?method),
  !isMethod(?method).

ContractProblem(?owner, "DICreationRequest", ?class, "Not a class") :-
  DICreationRequest(?owner, ?class),
  !isClassType(?class).

ContractProblem(?owner, "InjectionOffer", ?source, "Source is not a class, interface, method or field") :-
  InjectionOffer(?owner, ?source),
  !isClassType(?source),
  !isInterfaceType(?source),
  !isMethod(?source),
  !isField(?source).

ContractProblem(?owner, "InjectionOfferName", ?source, "Source is not offered by this owner") :-
  InjectionOfferName(?owner, ?source, _),
  !InjectionOffer(?owner, ?source).

ContractProblem(?owner, "InjectionOfferName", ?source, "Offer name is empty") :-
  InjectionOfferName(?owner, ?source, "").
