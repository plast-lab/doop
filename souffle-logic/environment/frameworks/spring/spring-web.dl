// ==========================================================================
// Spring Web (Spring MVC, Spring 5.3 to 7.0):
//
// Request handler methods on controllers (including inherited and interface
// mappings and Spring 5.3 class-level @RequestMapping), @ExceptionHandler /
// @InitBinder / @ModelAttribute methods, structural web callbacks (including
// OncePerRequestFilter / GenericFilterBean template hooks) and @ImportHttpServices
// declarative HTTP client interfaces (Spring 7.0+).
// ==========================================================================


Owner("spring-web").




// --------------------------------------------------------------------------
// Annotations, callback interfaces and filter template hooks
// --------------------------------------------------------------------------

.decl SpringWeb_Annotation(?role:symbol, ?annotation:Annotation)
EnvironmentAnnotation("spring-web", ?role, ?annotation) :-
  SpringWeb_Annotation(?role, ?annotation).

SpringWeb_Annotation("controller", "org.springframework.stereotype.Controller").
SpringWeb_Annotation("controller-advice", "org.springframework.web.bind.annotation.ControllerAdvice").
SpringWeb_Annotation("request-mapping", "org.springframework.web.bind.annotation.RequestMapping").
SpringWeb_Annotation("advice-method", "org.springframework.web.bind.annotation.ExceptionHandler").
SpringWeb_Annotation("advice-method", "org.springframework.web.bind.annotation.InitBinder").
SpringWeb_Annotation("advice-method", "org.springframework.web.bind.annotation.ModelAttribute").
SpringWeb_Annotation("http-exchange", "org.springframework.web.service.annotation.HttpExchange").
SpringWeb_Annotation("import-http-services", "org.springframework.web.service.registry.ImportHttpServices").
SpringWeb_Annotation("import-http-services-container", "org.springframework.web.service.registry.ImportHttpServices$Container").


.decl SpringWeb_CallbackInterface(?iface:ReferenceType)

SpringWeb_CallbackInterface("org.springframework.web.servlet.HandlerInterceptor").
SpringWeb_CallbackInterface("org.springframework.web.servlet.AsyncHandlerInterceptor").
SpringWeb_CallbackInterface("org.springframework.web.servlet.config.annotation.WebMvcConfigurer").
SpringWeb_CallbackInterface("org.springframework.web.method.support.HandlerMethodArgumentResolver").
SpringWeb_CallbackInterface("org.springframework.web.method.support.HandlerMethodReturnValueHandler").
SpringWeb_CallbackInterface("org.springframework.web.servlet.mvc.method.annotation.RequestBodyAdvice").
SpringWeb_CallbackInterface("org.springframework.web.servlet.mvc.method.annotation.ResponseBodyAdvice").
SpringWeb_CallbackInterface("org.springframework.web.context.ServletContextAware").
SpringWeb_CallbackInterface("org.springframework.web.context.ServletConfigAware").


// Specific template hooks on Spring's abstract servlet filter base classes
// (avoids marking inherited utility getters/setters as entry points).
.decl SpringWeb_FilterTemplateHook(?base:ReferenceType, ?methodName:symbol)

SpringWeb_FilterTemplateHook("org.springframework.web.filter.OncePerRequestFilter", "doFilterInternal").
SpringWeb_FilterTemplateHook("org.springframework.web.filter.OncePerRequestFilter", "doFilterNestedErrorDispatch").
SpringWeb_FilterTemplateHook("org.springframework.web.filter.OncePerRequestFilter", "shouldNotFilter").
SpringWeb_FilterTemplateHook("org.springframework.web.filter.OncePerRequestFilter", "shouldNotFilterAsyncDispatch").
SpringWeb_FilterTemplateHook("org.springframework.web.filter.OncePerRequestFilter", "shouldNotFilterErrorDispatch").
SpringWeb_FilterTemplateHook("org.springframework.web.filter.GenericFilterBean", "initFilterBean").




// --------------------------------------------------------------------------
// Controllers, advice, HTTP clients and entry points
// --------------------------------------------------------------------------

// Spring: concrete application classes carrying @Controller (or @RestController via chain),
// or (Spring 5.3) a class-level @RequestMapping.
.decl SpringWeb_Controller(?class:ClassType)

SpringWeb_Controller(?class) :-
  ApplicationClass(?class),
  ConcreteClassType(?class),
  ( SpringWeb_Annotation("controller", ?ann)
  ; SpringWeb_Annotation("request-mapping", ?ann) ),
  TypeCarries(?class, ?ann).


// Spring: @ControllerAdvice and @RestControllerAdvice classes.
.decl SpringWeb_Advice(?class:ClassType)

SpringWeb_Advice(?class) :-
  ApplicationClass(?class),
  ConcreteClassType(?class),
  SpringWeb_Annotation("controller-advice", ?ann),
  TypeCarries(?class, ?ann).


// Spring 7.0+: HTTP client interfaces registered as beans via @ImportHttpServices
// (either listed explicitly in value/types, or scanned when basePackages/basePackageClasses
// or an AbstractHttpServiceRegistrar subclass is present). Without a registrar, apps create
// @HttpExchange proxies manually inside @Bean methods, so bare interfaces are not offered.
.decl SpringWeb_HasHttpServiceScan()

SpringWeb_HasHttpServiceScan() :-
  SpringWeb_Annotation("import-http-services", ?ann),
  ( ?el = "basePackages" ; ?el = "basePackageClasses" ),
  TypeAnnotationValue(_, ?ann, ?el, _, _, _, _).

SpringWeb_HasHttpServiceScan() :-
  SpringWeb_Annotation("import-http-services-container", ?container),
  TypeAnnotationValue(_, ?container, "value", _, "annotation", ?nested, _),
  SpringWeb_Annotation("import-http-services", ?ann),
  ( ?el = "basePackages" ; ?el = "basePackageClasses" ),
  NestedAnnotationValue(?nested, ?ann, ?el, _, _, _, _).

SpringWeb_HasHttpServiceScan() :-
  ApplicationClass(?reg),
  ConcreteClassType(?reg),
  basic.SubtypeOf(?reg, "org.springframework.web.service.registry.AbstractHttpServiceRegistrar").


.decl SpringWeb_HttpClientInterface(?iface:InterfaceType)

SpringWeb_HttpClientInterface(?iface) :-
  SpringWeb_Annotation("import-http-services", ?ann),
  ( ?el = "value" ; ?el = "types" ),
  TypeAnnotationValue(_, ?ann, ?el, _, "class", ?iface, _),
  isInterfaceType(?iface).

SpringWeb_HttpClientInterface(?iface) :-
  SpringWeb_Annotation("import-http-services-container", ?container),
  TypeAnnotationValue(_, ?container, "value", _, "annotation", ?nested, _),
  SpringWeb_Annotation("import-http-services", ?ann),
  ( ?el = "value" ; ?el = "types" ),
  NestedAnnotationValue(?nested, ?ann, ?el, _, "class", ?iface, _),
  isInterfaceType(?iface).

SpringWeb_HttpClientInterface(?iface) :-
  SpringWeb_HasHttpServiceScan(),
  ApplicationClass(?iface),
  isInterfaceType(?iface),
  !basic.SubtypeOf(?iface, "java.lang.annotation.Annotation"),
  basic.SubtypeOf(?iface, ?super),
  isInterfaceType(?super),
  SpringWeb_Annotation("http-exchange", ?ann),
  ( TypeCarries(?super, ?ann)
  ; ( Method_DeclaringType(?method, ?super), MethodCarries(?method, ?ann) ) ).


// Proxied HTTP client interfaces are created at runtime and offered as beans.
// Known limit: group#FQCN bean names and base-package filtering are not modelled here.
EnvironmentCreatedType("spring-web", ?iface) :- SpringWeb_HttpClientInterface(?iface).
Injectable("spring-web", ?iface) :- SpringWeb_HttpClientInterface(?iface).


// Spring: request handler methods on controllers (including Spring 6+/7+ server-side
// @HttpExchange methods, which RequestMappingHandlerMapping handles alongside @RequestMapping).
// MethodRunOn covers mappings inherited from superclasses and interfaces.
EntryPoint("spring-web", ?run) :-
  SpringWeb_Controller(?class),
  ( SpringWeb_Annotation("request-mapping", ?ann)
  ; SpringWeb_Annotation("http-exchange", ?ann) ),
  MethodCarries(?method, ?ann),
  !Method_Modifier("static", ?method),
  MethodRunOn(?method, ?class, ?run).


// Spring: @ExceptionHandler, @InitBinder and @ModelAttribute methods on controllers
// and @ControllerAdvice classes.
EntryPoint("spring-web", ?run) :-
  ( SpringWeb_Controller(?class) ; SpringWeb_Advice(?class) ),
  SpringWeb_Annotation("advice-method", ?ann),
  MethodCarries(?method, ?ann),
  !Method_Modifier("static", ?method),
  MethodRunOn(?method, ?class, ?run).


// Spring: structural web callbacks on concrete application classes.
EntryPoint("spring-web", ?run) :-
  ApplicationClass(?class),
  ConcreteClassType(?class),
  SpringWeb_CallbackInterface(?iface),
  ApiMethodRunOn(?iface, ?class, ?run).

// Spring: servlet filter template hooks on OncePerRequestFilter / GenericFilterBean subclasses.
EntryPoint("spring-web", ?run) :-
  ApplicationClass(?class),
  ConcreteClassType(?class),
  SpringWeb_FilterTemplateHook(?base, ?name),
  basic.SubtypeOf(?class, ?base),
  Method_DeclaringType(?baseMethod, ?base),
  Method_SimpleName(?baseMethod, ?name),
  !Method_Modifier("private", ?baseMethod),
  !Method_Modifier("static", ?baseMethod),
  MethodRunOn(?baseMethod, ?class, ?run).
