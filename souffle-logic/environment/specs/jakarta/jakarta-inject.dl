// ==========================================================================
// Jakarta Inject (JSR-330 / jakarta.inject and javax.inject):
//
// Handoffs only: @Inject asks whoever injects into an object to fill a field,
// method parameter or constructor parameter.
// Picking which object goes into each slot is the injecting framework's job
// (e.g. spring.dl).
// ==========================================================================


Owner("jakarta-inject").




// --------------------------------------------------------------------------
// Annotations
// --------------------------------------------------------------------------

.decl JakartaInject_Annotation(?role:symbol, ?annotation:Annotation)
EnvironmentAnnotation("jakarta-inject", ?role, ?annotation) :-
  JakartaInject_Annotation(?role, ?annotation).

JakartaInject_Annotation("inject", ?annotation) :- JakartaOrJavaxName("inject.Inject", ?annotation).

// @Named and @Qualifier are published only: which object a name or qualifier selects
// is the injecting framework's job (spring.dl reads them from EnvironmentAnnotation).
JakartaInject_Annotation("named", ?annotation) :- JakartaOrJavaxName("inject.Named", ?annotation).

JakartaInject_Annotation("qualifier", ?annotation) :- JakartaOrJavaxName("inject.Qualifier", ?annotation).




// --------------------------------------------------------------------------
// Handoffs
// --------------------------------------------------------------------------

// Jakarta: @Inject fields, except static and final ones (Inject Javadoc).
InjectionPoint("jakarta-inject", ?field) :-
  JakartaInject_Annotation("inject", ?ann),
  FieldCarries(?field, ?ann),
  !Field_Modifier("static", ?field),
  !Field_Modifier("final", ?field).


// Jakarta: parameters of non-static @Inject methods.
// The contract's ParamOf drops methods overridden without @Inject.
InjectionPoint("jakarta-inject", ?param) :-
  JakartaInject_Annotation("inject", ?ann),
  MethodCarries(?method, ?ann),
  !Method_Modifier("static", ?method),
  !ConstructorOf(?method, _),
  FormalParam(_, ?method, ?param).


// Jakarta: parameters of @Inject constructors.
// The contract applies these only when the framework also creates the object.
InjectionPoint("jakarta-inject", ?param) :-
  JakartaInject_Annotation("inject", ?ann),
  ConstructorOf(?ctor, _),
  MethodCarries(?ctor, ?ann),
  FormalParam(_, ?ctor, ?param).
