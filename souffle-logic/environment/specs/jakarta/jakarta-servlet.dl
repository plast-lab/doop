// ==========================================================================
// Jakarta Servlet (jakarta.servlet and javax.servlet):
//
// Concrete application classes implementing Servlet, Filter or a servlet
// listener interface are created by the container and have their servlet API
// methods called on them.
// ==========================================================================


Owner("jakarta-servlet").




// --------------------------------------------------------------------------
// Servlet API types
// --------------------------------------------------------------------------

// The servlet API types, by their name without the jakarta. or javax. prefix.
.decl JakartaServlet_ApiName(?suffix:symbol)

JakartaServlet_ApiName("servlet.Servlet").
JakartaServlet_ApiName("servlet.GenericServlet").
JakartaServlet_ApiName("servlet.http.HttpServlet").
JakartaServlet_ApiName("servlet.Filter").
JakartaServlet_ApiName("servlet.http.HttpFilter").
JakartaServlet_ApiName("servlet.ServletContextListener").
JakartaServlet_ApiName("servlet.ServletContainerInitializer").
JakartaServlet_ApiName("servlet.AsyncListener").
JakartaServlet_ApiName("servlet.ReadListener").
JakartaServlet_ApiName("servlet.WriteListener").
JakartaServlet_ApiName("servlet.ServletRequestListener").
JakartaServlet_ApiName("servlet.ServletRequestAttributeListener").
JakartaServlet_ApiName("servlet.ServletContextAttributeListener").
JakartaServlet_ApiName("servlet.http.HttpUpgradeHandler").
JakartaServlet_ApiName("servlet.http.HttpSessionListener").
JakartaServlet_ApiName("servlet.http.HttpSessionActivationListener").
JakartaServlet_ApiName("servlet.http.HttpSessionAttributeListener").
JakartaServlet_ApiName("servlet.http.HttpSessionBindingListener").
JakartaServlet_ApiName("servlet.http.HttpSessionIdListener").


.decl JakartaServlet_ApiType(?type:ReferenceType)

JakartaServlet_ApiType(?type) :-
  JakartaServlet_ApiName(?suffix),
  JakartaOrJavaxName(?suffix, ?type).




// --------------------------------------------------------------------------
// Contract interface
// --------------------------------------------------------------------------

// Jakarta: concrete application classes implementing a servlet API type.
.decl JakartaServlet_Component(?class:ClassType)

JakartaServlet_Component(?class) :-
  ApplicationClass(?class),
  ConcreteClassType(?class),
  JakartaServlet_ApiType(?apiType),
  basic.SubtypeOf(?class, ?apiType).


FrameworkCreatedType("jakarta-servlet", ?class) :-
  JakartaServlet_Component(?class).


// Jakarta: servlet API methods (init, service, doGet, doFilter, listener callbacks...)
// that run on the component class.
EntryPoint("jakarta-servlet", ?run) :-
  JakartaServlet_Component(?class),
  JakartaServlet_ApiType(?apiType),
  ApiMethodRunOn(?apiType, ?class, ?run).
