#pragma once
// ============================================================================
// The user taint specification (--taint-spec FILE).
//
// A tab-separated file, one entry per line, blank lines and '#' lines ignored:
//   <kind> <columns...>
// where <kind> is one of the source / sink / sanitizer / transfer relations below
// and the columns are that relation's own, in order: a free-text label, a
// parameter index, and a method / field / type id. The id column may be a regex
// over the whole id (Souffle's match, whole-string); the fact generator flags it
// as one when it holds a regex operator no Doop id contains (anything of
// `* + ? | ^ { } \`, or a `[` that is not the array suffix `[]`).
//
//   TaintSourceReturn       src     <Main: java.lang.String untrusted()>
//   TaintSinkActualParam    sink    0   <java.io.PrintWriter: void println[(].*[)]>
//   TaintSanitizer          <java.net.URLEncoder: java.lang.String encode[(].*[)]>
//   TaintSourceType         type    Main$Token
//   TaintSinkAppOnly        <android.util.Log: int [a-z]+[(].*[)]>     (scope flag)
//
// FactGenerator0.writeTaintSpec checks kind and column count and writes
// TaintSpecEntry(kind, c1, c2, c3, pattern) with "" padding; the rules below
// put each entry into its relation, so override expansion, the diagnostics
// (diagnostics.dl: an exact id that is not in the program, a regex that matches
// nothing) and the leak rules see it exactly as a profile fact. An exact id
// enters its relation unchecked on purpose: that is what makes a dead id
// visible to TaintSpecUnmatched. The legacy keep-spec TAINT lines (TaintSpec,
// core.dl) keep their meaning.
// ============================================================================

.decl TaintSpecEntry(?kind:symbol, ?c1:symbol, ?c2:symbol, ?c3:symbol, ?pattern:symbol)
.input TaintSpecEntry(filename="TaintSpecEntry.facts")

TaintSourceReturn(?label, as(?id, Method)) :-
  TaintSpecEntry("TaintSourceReturn", ?label, ?id, _, "0").
TaintSourceReturn(?label, ?m) :-
  TaintSpecEntry("TaintSourceReturn", ?label, ?re, _, "1"),
  isMethod(?m),
  match(?re, ?m).
TaintPattern("TaintSourceReturn", ?re) :-
  TaintSpecEntry("TaintSourceReturn", _, ?re, _, "1").

TaintSourceFormalParam(?label, to_number(?index), as(?id, Method)) :-
  TaintSpecEntry("TaintSourceFormalParam", ?label, ?index, ?id, "0").
TaintSourceFormalParam(?label, to_number(?index), ?m) :-
  TaintSpecEntry("TaintSourceFormalParam", ?label, ?index, ?re, "1"),
  isMethod(?m),
  match(?re, ?m).
TaintPattern("TaintSourceFormalParam", ?re) :-
  TaintSpecEntry("TaintSourceFormalParam", _, _, ?re, "1").

TaintSourceActualParam(?label, to_number(?index), as(?id, Method)) :-
  TaintSpecEntry("TaintSourceActualParam", ?label, ?index, ?id, "0").
TaintSourceActualParam(?label, to_number(?index), ?m) :-
