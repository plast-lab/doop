TaintTransferBaseToReturn("<java.lang.String: char[] toCharArray()>").
TaintTransferBaseToReturn("<java.lang.String: java.lang.String intern()>").

/*
TaintTransferBaseToReturn("<java.lang.String: java.lang.String format(java.lang.String,java.lang.Object[])>").
TaintTransferBaseToReturn("<java.lang.String: java.lang.String format(java.util.Locale,java.lang.String,java.lang.Object[])>").
