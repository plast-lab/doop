#pragma once

#include "macros.dl"

#ifdef DISABLE_POINTS_TO
// Mark methods as taint-transfer for shallow analyses.

TaintTransferActualParamToBase(0, ?method),
TaintTransferActualParamToReturn(?method) :-
  Method_DeclaringType(?method, "java.lang.StringBuilder"),
  Method_SimpleName(?method, ?name),
  (?name = "append" ; ?name = "appendCodePoint").

TaintTransferBaseToReturn("<java.lang.StringBuilder: java.lang.String toString()>").

#endif // DISABLE_POINTS_TO

TaintTransferActualParamToBase(0, "<java.lang.StringBuffer: java.lang.StringBuffer append(java.lang.Object)>").
TaintTransferActualParamToBase(0, "<java.lang.StringBuffer: java.lang.StringBuffer append(java.lang.String)>").
TaintTransferActualParamToBase(0, "<java.lang.StringBuffer: java.lang.StringBuffer append(java.lang.StringBuffer)>").
TaintTransferActualParamToBase(0, "<java.lang.StringBuffer: java.lang.StringBuffer append(java.lang.CharSequence)>").
TaintTransferActualParamToBase(0, "<java.lang.StringBuffer: java.lang.StringBuffer append(char[])>").
TaintTransferActualParamToBase(0, "<java.lang.StringBuffer: java.lang.StringBuffer append(char)>").

TaintTransferBaseToReturn("<java.lang.Float: float floatValue()>").
TaintTransferBaseToReturn("<java.lang.String: byte[] getBytes(java.lang.String)>").
TaintTransferBaseToReturn("<java.lang.String: char charAt(int)>").
TaintTransferBaseToReturn("<java.util.Enumeration: java.lang.Object nextElement()>").
TaintTransferBaseToReturn("<java.util.Iterator: java.lang.Object next()>").
TaintTransferBaseToReturn("<java.util.LinkedList: java.lang.Object clone()>").
TaintTransferBaseToReturn("<java.util.LinkedList: java.lang.Object get(int)>").
TaintTransferBaseToReturn("<java.util.Map: java.util.Set entrySet()>").
TaintTransferBaseToReturn("<java.util.Map$Entry: java.lang.Object getValue()>").
TaintTransferBaseToReturn("<java.util.Set: java.util.Iterator iterator()>").

