#pragma once

#include "../../commonMacros.dl"

#define DEFAULT_BREADCRUMB "ASSIGN"

#define ValueIdMacro(id, type, breadcrumb) \
  cat(cat(cat(cat(id, "::: "), type), "::: "), breadcrumb)

#define TaintedValueIntroduced(declaringType, id, type, label, value) \
  mainAnalysis_MockValueConsMacro(value, type), \
  TaintedValue(value), \
  SourceFromTaintedValue(value, id), \
  LabelFromSource(id, label), \
  mainAnalysis.Value_DeclaringType(value, declaringType)

// Each pattern macro also records the pattern (TaintPattern), so that one
// matching no method is reported by diagnostics.dl.
#define TaintSourceReturnPattern(label, pattern) \
  TaintPattern("TaintSourceReturnPattern", pattern). \
  TaintSourceReturn(label, method) :- \
    isMethod(method), \
    match(pattern, method)

#define TaintSinkActualParamPattern(label, n, pattern) \
  TaintPattern("TaintSinkActualParamPattern", pattern). \
  TaintSinkActualParam(label, n, method) :- \
    isMethod(method), \
    match(pattern, method)
