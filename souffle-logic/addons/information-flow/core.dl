#pragma once
/**
 * This file contains core information flow analysis rules that do not
 * require an existing points-to infrastructure. Adding points-to support to
 * this core results in "P/Taint" but these rules are also used by the independent
 * data-flow taint analysis.
 */

AnyMethodInvocation(?invocation, ?tomethod) :-
  StaticMethodInvocation(?invocation, ?tomethod, _).

AnyMethodInvocation(?invocation, ?tomethod) :-
  VirtualMethodInvocation(?invocation, ?tomethod, _).

AnyMethodInvocation(?invocation, ?tomethod) :-
  MethodInvocation_Method(?invocation, ?tomethod),
  isSpecialMethodInvocation_Insn(?invocation).

VarUse(?from, ?insn) :-
  AssignOper_From(?insn, _, ?from).

TaintSinkActualParam(?label, ?index, ?method) :-
  TaintSinkAnyActualParam(?label, ?method),
  FormalParam(?index, ?method, _).

MethodInvocationInfo(?invocation, ?type, ?ret) :-
  Method_ReturnType(?method, ?type),
  AnyMethodInvocation(?invocation, ?method),
  AssignReturnValue(?invocation, ?ret).

VarIsCast(?var) :-
  AssignCast(_, ?var, _, _).

TypeForReturnValue(?type, ?ret, ?invocation) :-
  MethodInvocationInfo(?invocation, ?type, ?ret),
  !VarIsCast(?ret).

// Sources produce taint at ANY REACHABLE call site, symmetric with the sink
// rules below. The old ApplicationMethod(?inmethod) filter required the source's
// immediate caller to be app code -- which is directionally WRONG for a source:
// a library/framework source (e.g. a container reading untrusted input) is called
// by the library, and its tainted result flows DOWNSTREAM into the app. Requiring
// the source's caller to be app suppresses exactly those legitimate library
// sources. Plain reachability is also sound: an over-approximate library source
// whose taint never reaches a sink produces no finding, only unused taint.
TaintSourceReturnInvocation(?label, ?ctx, ?invocation) :-
  TaintSourceReturn(?label, ?tomethod),
  MethodInvocationInContext(?ctx, ?invocation, ?tomethod).

/**
 * Taint transfer through aliasing
 */
TaintTransferMethodInvocationInContext(?ctx, ?index, ?invocation) :-
  MethodInvocationInContext(?ctx, ?invocation, ?taintTransferMethod),
  TaintTransferActualParamToBase(?index, ?taintTransferMethod).

ParamTaintTransferredToBase(?param, ?ctx, ?base) :-
  TaintTransferMethodInvocationInContext(?ctx, ?index, ?invocation),
  ActualParam(?index, ?invocation, ?param),
  MethodInvocation_Base(?invocation, ?base),
  !AssignReturnValue(?invocation, _).

MethodInvocationInContextInApplication(?ctx, ?invocation, ?method) :-
  ApplicationMethod(?fromMethod),
  Instruction_Method(?invocation, ?fromMethod),
  MethodInvocationInContext(?ctx, ?invocation, ?method).

ParamTaintTransferredToRet(?type, ?ret, ?ctx, ?param) :-
  TaintTransferActualParamToReturn(?taintTransferMethod),
  MethodInvocationInContextInApplication(?ctx, ?invocation, ?taintTransferMethod),
  ActualParam(_, ?invocation, ?param),
  TypeForReturnValue(?type, ?ret, ?invocation).

/**
 * Variable tainting
 */
VarIsTaintedFromVar(?type, ?ctx, ?param, ?ctx, ?base) :-
   MethodInvocationInContextInApplication(?ctx, ?invocation, ?method),
   TaintTransferBaseToActualParam(?method),
   MethodInvocation_Base(?invocation, ?base),
   ActualParam(_, ?invocation, ?param),
   Var_Type(?param, ?type).

VarIsTaintedFromVar(?type, ?ctx, ?ret, ?ctx, ?base) :-
  TaintTransferBaseToReturn(?method),
  MethodInvocationInContext(?ctx, ?invocation, ?method),
  MethodInvocation_Base(?invocation, ?base),
  TypeForReturnValue(?type, ?ret, ?invocation).

VarIsTaintedFromVarIndex(?base, ?ctx, ?param) :-
   MethodInvocationInContext(?ctx, ?invocation, ?method),
   TaintTransferActualParamElementsToBase(?index, ?method),
   MethodInvocation_Base(?invocation, ?base),
   ActualParam(?index, ?invocation, ?param).

/**
 * Sinks and leaks
 *
 * Sinks fire at ANY REACHABLE call site of the sink method, not only call sites
 * whose immediate caller is application code. MethodInvocationInContext is
 * already derived from mainAnalysis.ReachableContext, so it is inherently
 * reachability-scoped; using it instead of MethodInvocationInContextInApplication
 * drops only the extra ApplicationMethod(?fromMethod) filter. This lets a sink
 * placed on a library-internal method (e.g. a parser/allocator deep inside a
 * dependency) report when tainted application data reaches it -- the common
 * real-world case the app-only gate previously suppressed. The transfer-method
 * and serialization rules deliberately keep the stricter app-only gate.
 */
TaintSinkVar(?label, ?invocation, ?ctx, ?var) :-
  TaintSinkActualParam(?label, ?index, ?tomethod),
  MethodInvocationInContext(?ctx, ?invocation, ?tomethod),
  ActualParam(?index, ?invocation, ?var).

// Base sink: the receiver variable at each reachable call site.
TaintSinkVar(?label, ?invocation, ?ctx, ?var) :-
   TaintSinkBase(?label, ?tomethod),
   MethodInvocationInContext(?ctx, ?invocation, ?tomethod),
   MethodInvocation_Base(?invocation, ?var).

// Default override expansion for every method-keyed source: a source declared on
// a method is also a source on every method overriding it.
TaintSourceReturn(?label, ?overrideMethod) :-
  TaintSourceReturn(?label, ?method),
  basic.MethodOverridesOther(?overrideMethod, ?method).
TaintSourceFormalParam(?label, ?index, ?overrideMethod) :-
  TaintSourceFormalParam(?label, ?index, ?method),
  basic.MethodOverridesOther(?overrideMethod, ?method).

// User-provided taint sources (keep-spec channel: method return values only).
TaintSourceReturn(?label, ?method) :-
  TaintSpec("TAINT_SOURCE", ?label, ?method),
  isMethod(?method).
// User-provided taint sinks (keep-spec channel). The legacy meaning is kept:
// a method with parameters sinks every actual, a method without sinks the receiver.
TaintSinkAnyActualParam(?label, ?method) :-
  TaintSpec("TAINT_SINK", ?label, ?method),
  isMethod(?method),
  FormalParam(_, ?method, _).
TaintSinkBase(?label, ?method) :-
  TaintSpec("TAINT_SINK", ?label, ?method),
  isMethod(?method),
  !FormalParam(_, ?method, _).