#pragma once
/**
 * This file contains information flow analysis rules that require
 * an existing points-to analysis.
 */
#include "macros.dl"
#include "declarations.dl"
#include "delta.dl"
#include "core.dl"

#ifndef DISABLE_POINTS_TO

Markable(?value) :-
  mainAnalysis.Value_isHeap(?value),
  !mainAnalysis.HeapAllocation_Merge(?value, _),
  !mainAnalysis.HeapAllocation_Merge(_, ?value),
  !mainAnalysis.Value_Null(?value),
  !isStringConstant(?value),
  // merged representative for reflection strings, not covered by HeapAllocation_Merge
  ?value != "<<reflection-string-constant>>".
// Doop's other <<...>> pseudo-heaps (<<main-thread>>, <<main method array>>,
// <<main method array content>>, the context pseudo-heaps) are per-program
// singletons, not merges of allocation sites, and stay markable: a source on
// main(String[]) must be able to mark the argument array.

#ifdef MODEL_PRIMITIVES
Markable(?value) :-
  mainAnalysis.Value_isMock(?value),
  ( substr(?value, 0, 12) = "<prim-param " ;
    substr(?value, 0, 12) = "<prim-arith " ;
    substr(?value, 0, 11) = "<prim-conv " ).
#endif // MODEL_PRIMITIVES

AppMarkable(?value) :-
  Markable(?value),
  AssignHeapAllocation(?value, _, ?method),
  ApplicationMethod(?method).

#ifdef MODEL_PRIMITIVES
// A primitive mock is "allocated" by its site; the site's method decides.
AppMarkable(?value) :-
  Markable(?value),
  mainAnalysis.PrimitiveMock_Method(?value, ?method),
  ApplicationMethod(?method).
#endif // MODEL_PRIMITIVES

TaintObjTransfer(?fromCtx, ?from, ?toCtx, ?to),
TaintedVarTaintedFromVar(?toCtx, ?to, ?value, ?type) :-
  VarIsTaintedFromVar(?type, ?toCtx, ?to, ?fromCtx, ?from),
  TaintedVarPointsTo(?value, ?fromCtx, ?from).
  .plan 1:(2,1)

mainAnalysis_MockValueConsMacro(?value, ?type),
TaintedValue(?value),
SourceFromTaintedValue(?value, ?source),
mainAnalysis.Value_DeclaringType(?value, ?declaringType) :-
  TaintedValueTransferred(?declaringType, ?source, ?type, ?value).

TaintedValueTransferred(?declaringType, ?source, ?type, ValueIdMacro(?source, ?type, DEFAULT_BREADCRUMB)),
mainAnalysis.VarPointsTo(?hctx, ValueIdMacro(?source, ?type, DEFAULT_BREADCRUMB), ?toCtx, ?to) :-
  TaintedVarTaintedFromVar(?toCtx, ?to, ?value, ?type),
  SourceFromTaintedValue(?value, ?source),
  mainAnalysis.Value_DeclaringType(?value, ?declaringType),
  mainAnalysis.isImmutableHContext(?hctx).
  .plan 2:(3,1,2,4)

TaintedValueTransferred(?declaringType, ?source, ?type, ValueIdMacro(?source, ?type, DEFAULT_BREADCRUMB)),
mainAnalysis.VarPointsTo(?hctx, ValueIdMacro(?source, ?type, DEFAULT_BREADCRUMB), ?toCtx, ?to) :-
  SourceFromTaintedValue(?value, ?source),
  mainAnalysis.Value_DeclaringType(?value, ?declaringType),
  VarIsTaintedFromValue(?type, ?value, ?toCtx, ?to),
  mainAnalysis.isImmutableHContext(?hctx).

// I expect the first rel to be very small, smaller than
// the deltas of VPT or AIPT
VarIsTaintedFromValueIndex(?ctx, ?base, ?hctx, ?value) :-
   VarIsTaintedFromVarIndex(?base, ?ctx, ?param),
   mainAnalysis.VarPointsTo(?hctx, ?value, ?ctx, ?param).

VarIsTaintedFromValue(?type, ?valueIndex, ?ctx, ?base) :-
  VarIsTaintedFromValueIndex(?ctx, ?base, ?hctx, ?value),
  mainAnalysis.ArrayIndexPointsTo(_, ?valueIndex, ?hctx, ?value),
  Var_Type(?base, ?type).

#endif // DISABLE_POINTS_TO

/**
 * Information flow through complex relations
 */
.decl AppendableType(?type:Type)

AppendableType("java.lang.Appendable").

AppendableType(?type) :-
   basic.SubtypeOf(?type, ?sft),
   AppendableType(?sft).

mainAnalysis.StringFactoryType("java.lang.String").

mainAnalysis.StringFactoryType(?type) :-
   AppendableType(?type).

#ifndef DISABLE_POINTS_TO

mainAnalysis.StringFactoryVar(?var) :-
  mainAnalysis.StringFactoryType(?type),
  Var_Type(?var, ?type).

mainAnalysis.StringFactoryVarPointsTo(?factoryHctx, ?factoryValue, ?ctx, ?var) :-
  mainAnalysis.StringFactoryVar(?var),
  mainAnalysis.VarPointsTo(?factoryHctx, ?factoryValue, ?ctx, ?var).

.decl AppendInvocation_Base(?invocation:MethodInvocation, ?base:Var)

AppendInvocation_Base(?invocation, ?base) :-
  VirtualMethodInvocation_SimpleName(?invocation, "append"),
  VirtualMethodInvocation_Base(?invocation, ?base).

VarIsTaintedFromVar(?type, ?ctx, ?ret, ?ctx, ?base),
VarIsTaintedFromVar(?type, ?ctx, ?ret, ?ctx, ?param) :-
  AppendInvocation_Base(?invocation, ?base),
  mainAnalysis.StringFactoryVarPointsTo(_, _, ?ctx, ?base),
  AssignReturnValue(?invocation, ?ret),
  Var_Type(?ret, ?type),
  ActualParam(0, ?invocation, ?param).

VarIsTaintedFromVar(?type, ?ctx, ?base, ?ctx, ?param) :-
  AppendInvocation_Base(?invocation, ?base),
  mainAnalysis.StringFactoryVarPointsTo(_, _, ?ctx, ?base),
  Var_Type(?base, ?type),
  ActualParam(0, ?invocation, ?param).

#endif // DISABLE_POINTS_TO

MethodReturningStringFactory(?tomethod) :-
  mainAnalysis.StringFactoryType(?stringFactoryType),
  Method_ReturnType(?tomethod, ?stringFactoryType).

StringFactoryReturnInvocation(?invocation) :-
  MethodReturningStringFactory(?tomethod),
  VirtualMethodInvocation(?invocation, ?tomethod, _).

#ifndef DISABLE_POINTS_TO
VarIsTaintedFromVar(?type, ?ctx, ?ret, ?ctx, ?base) :-
  mainAnalysis.StringFactoryVarPointsTo(_, _, ?ctx, ?base),
  VirtualMethodInvocation_Base(?invocation, ?base),
  StringFactoryReturnInvocation(?invocation),
  AssignReturnValue(?invocation, ?ret),
  Var_Type(?ret, ?type).

VarIsTaintedFromValue(?componentType, ?basevalue, ?ctx, ?to) :-
  TaintedValue(?basevalue),
  mainAnalysis.Value_Type(?basevalue, ?arrayType),
  ComponentType(?arrayType, ?componentType),
  mainAnalysis.LoadHeapArrayIndex(?ctx, ?to, _, ?basevalue).

TypeForReturnValue(?type, ?ret, ?invocation) :-
  mainAnalysis.OptAssignCast(?type, _, ?ret),
  MethodInvocationInfo(?invocation, _, ?ret).

TaintObjTransfer(?ctx, ?from, ?ctx, ?to),
TaintedValueTransferred(?declaringType, ?source, ?type, ValueIdMacro(?source, ?type, DEFAULT_BREADCRUMB)),
mainAnalysis.VarPointsTo(?hctx, ValueIdMacro(?source, ?type, DEFAULT_BREADCRUMB), ?ctx, ?to) :-
  SourceFromTaintedValue(?value, ?source),
  mainAnalysis.Value_DeclaringType(?value, ?declaringType),
  TaintedVarPointsTo(?value, ?ctx, ?from),
  ParamTaintTransferredToRet(?type, ?to, ?ctx, ?from),
  mainAnalysis.isImmutableHContext(?hctx).

// Rules for taint propagation through mock taint objects (without a concrete type)
TaintObjTransfer(?ctx, ?param, ?ctx, ?to),
TaintedValueTransferred(?declaringType, ?source, ?type, ValueIdMacro(?source, ?type, DEFAULT_BREADCRUMB)),
mainAnalysis.VarPointsTo(?hctx, ValueIdMacro(?source, ?type, DEFAULT_BREADCRUMB), ?ctx, ?to) :-
  TaintedVarPointsTo(?value, ?ctx, ?param),
  ActualParam(_, ?invo, ?param),
  MethodInvocation_Method(?invo, ?meth),
  TaintTransferActualParamToReturnMock(?meth),
  AssignReturnValue(?invo, ?to),
  Var_Type(?to, ?type),
  mainAnalysis.Value_DeclaringType(?value, ?declaringType),
  SourceFromTaintedValue(?value, ?source),
  mainAnalysis.isImmutableHContext(?hctx).
.plan 1:(7,1,2,3,4,5,6,8,9),2:(8,1,2,3,4,5,6,7,9)

// Cast bridge. A cast re-mints a tainted value in the cast's type so that a
// value up-typed by a transfer (an Object-typed Iterator.next() result, say) can
// be brought back down. Only a STRICT DOWNCAST of the value's own type does that:
// an upcast flows the value itself through the ordinary cast rule, and a cast to
// an unrelated type fails at run time, so the ordinary rule drops the value. The
// old unconditional form re-minted every tainted value in an Object-typed
// variable into whatever that variable was ever cast to; in the JDK (HashMap
// values, Object[] contents) that is every type in the program, and the mocks
// flooded the type universe (437 types per source in the msgpack run).
TaintedValueTransferred(?declaringType, ?source, ?type, ValueIdMacro(?source, ?type, DEFAULT_BREADCRUMB)),
mainAnalysis.VarPointsTo(?hctx, ValueIdMacro(?source, ?type, DEFAULT_BREADCRUMB), ?ctx, ?to) :-
  TaintedVarPointsTo(?value, ?ctx, ?from),
  AssignCast(_, ?from, ?to, _),
  mainAnalysis.Value_DeclaringType(?value, ?declaringType),
  SourceFromTaintedValue(?value, ?source),
  Var_Type(?to, ?type),
  isReferenceType(?type),
  mainAnalysis.Value_Type(?value, ?valueType),
  basic.SubtypeOf(?type, ?valueType),
  ?type != ?valueType,
  mainAnalysis.isImmutableHContext(?hctx).
.plan 1:(3,1,2,4,5,6,7,8,9),2:(4,1,2,3,5,6,7,8,9)

// A cast to a primitive type is a conversion, not a type test: the result is a
// fresh primitive value, re-minted in the target type as before.
TaintedValueTransferred(?declaringType, ?source, ?type, ValueIdMacro(?source, ?type, DEFAULT_BREADCRUMB)),
mainAnalysis.VarPointsTo(?hctx, ValueIdMacro(?source, ?type, DEFAULT_BREADCRUMB), ?ctx, ?to) :-
  TaintedVarPointsTo(?value, ?ctx, ?from),
  AssignCast(_, ?from, ?to, _),
  mainAnalysis.Value_DeclaringType(?value, ?declaringType),
  SourceFromTaintedValue(?value, ?source),
  Var_Type(?to, ?type),
  isPrimitiveType(?type),
  mainAnalysis.isImmutableHContext(?hctx).
.plan 1:(3,1,2,4,5,6,7),2:(4,1,2,3,5,6,7)

TaintObjTransfer(?ctx, ?base, ?ctx, ?to),
TaintedValueTransferred(?declaringType, ?source, ?type, ValueIdMacro(?source, ?type, DEFAULT_BREADCRUMB)),
mainAnalysis.VarPointsTo(?hctx, ValueIdMacro(?source, ?type, DEFAULT_BREADCRUMB), ?ctx, ?to) :-
  TaintedVarPointsTo(?value, ?ctx, ?base),
  VirtualMethodInvocation_Base(?invo, ?base),
  MethodInvocation_Method(?invo, ?meth),
  TaintTransferBaseToReturnMock(?meth),
  AssignReturnValue(?invo, ?to),
  Var_Type(?to, ?type),
  mainAnalysis.Value_DeclaringType(?value, ?declaringType),
  SourceFromTaintedValue(?value, ?source),
  mainAnalysis.isImmutableHContext(?hctx).
.plan 1:(7,1,2,3,4,5,6,8,9),2:(8,1,2,3,4,5,6,7,9)

#ifdef INFORMATION_FLOW_HIGH_SOUNDNESS
.decl ValueTaintedFromValue(?v1:Value, ?v2:Value)

ValueTaintedFromValue(?newvalue, ?baseObj) :-
  BaseValueTaintedFromParamValue(?newvalue, ?baseObj),
  ?newvalue != ?baseObj.

mainAnalysis.VarPointsTo(?hctx, ?newvalue, ?ctx, ?var) :-
  ValueTaintedFromValue(?newvalue, ?existingvalue),
  mainAnalysis.VarPointsTo(_, ?existingvalue, ?ctx, ?var),
  mainAnalysis.isImmutableHContext(?hctx).
  .plan 1:(2,1,3)

.decl XYZ(?value:Value, ?ctx:mainAnalysis.configuration.Context, ?param:Var)

XYZ(?existingvalue, ?ctx, ?param) :-
  ParamTaintTransferredToBase(?param, ?ctx, ?base),
  mainAnalysis.VarPointsTo(_, ?existingvalue, ?ctx, ?base).

.decl BaseValueTaintedFromParamValue(v1:Value, v2:Value)

TaintedValueTransferred(?declaringType, ?source, ?type, ValueIdMacro(?source, ?type, DEFAULT_BREADCRUMB)),
BaseValueTaintedFromParamValue(ValueIdMacro(?source, ?type, DEFAULT_BREADCRUMB), ?existingValue) :-
  XYZ(?existingValue, ?ctx, ?param),
  mainAnalysis.Value_Type(?existingValue, ?type),
  TaintedVarPointsTo(?value, ?ctx, ?param),
  SourceFromTaintedValue(?value, ?source),
  mainAnalysis.Value_DeclaringType(?value, ?declaringType).
  .plan 1:(2,1,3,4,5), 2:(3,1,2,4,5), 3:(4,3,1,2,5), 4:(5,3,1,2,4)
#else
.decl XYZ2(?type:Type, ?value:Value, ?ctx:mainAnalysis.configuration.Context, ?param:Var)

XYZ2(?type, ?value, ?ctx, ?param) :-
  ParamTaintTransferredToBase(?param, ?ctx, ?base),
  mainAnalysis.VarPointsTo(_, ?value, ?ctx, ?base),
  mainAnalysis.Value_isHeap(?value),
  mainAnalysis.Value_Type(?value, ?type).

TaintObjTransfer(?ctx, ?from, ?ctx, ?var),
TaintedValueTransferred(?declaringType, ?source, ?type, ValueIdMacro(?source, ?type, DEFAULT_BREADCRUMB)),
mainAnalysis.VarPointsTo(?hctx, ValueIdMacro(?source, ?type, DEFAULT_BREADCRUMB), ?ctx, ?var) :-
  XYZ2(?type, ?oldvalue, ?ctx, ?from),
  TaintedVarPointsTo(?value, ?ctx, ?from),
  mainAnalysis.AssignNormalHeapAllocation(?oldvalue, ?var, _),
  SourceFromTaintedValue(?value, ?source),
  mainAnalysis.Value_DeclaringType(?value, ?declaringType),
  mainAnalysis.isImmutableHContext(?hctx).
#endif // INFORMATION_FLOW_HIGH_SOUNDNESS

#ifdef INFORMATION_FLOW_HIGH_SOUNDNESS
// Option 1
.decl MethodInvocationInMethod(?tomethod:Method, ?invocation:MethodInvocation, ?inmethod:Method)

MethodInvocationInMethod(?tomethod, ?invocation, ?inmethod) :-
  AnyMethodInvocation(?invocation, ?tomethod),
  Instruction_Method(?invocation, ?inmethod).

MethodInvocationInContext(?ctx, ?invocation, ?tomethod) :-
  mainAnalysis.ReachableContext(?ctx, ?inmethod),
  MethodInvocationInMethod(?tomethod, ?invocation, ?inmethod).
#else
// Option 2
MethodInvocationInContext(?ctx, ?invocation, ?tomethod) :-
  mainAnalysis.CallGraphEdge(?ctx, ?invocation, _, ?tomethod).
#endif // INFORMATION_FLOW_HIGH_SOUNDNESS

// This captures the pattern x = invokedynamic(y) and transfers taint from
// y to x, when such an instruction is marked with AssignInvokedynamic.
VarIsTaintedFromVar(?type, ?ctx, ?ret, ?ctx, ?arg) :-
  mainAnalysis.AssignInvokedynamic(?insn, ?ret, _, ?type),
  ActualParam(_, ?insn, ?arg),
  TaintedVarPointsTo(_, ?ctx, ?arg).

/**
 * Sinks and leaks (on top of points-to reasoning)
 */
LeakingTaintedInformation(?sourceLabel, ?destLabel, ?ctx, ?invocation, ?source) :-
  SourceFromTaintedValue(?value, ?source),
  LabelFromSource(?source, ?sourceLabel),
  TaintedVarPointsTo(?value, ?ctx, ?var),
  TaintSinkVar(?destLabel, ?invocation, ?ctx, ?var).

LeakingTaintedInformationVars(?fromCtx, ?from, ?toCtx, ?to) :-
  TaintedVarPointsTo(?value, ?toCtx, ?to),
  TaintSinkVar(_, _, ?toCtx, ?to),
  SourceFromTaintedValue(?value, ?from),
  Var_DeclaringMethod(?from, ?meth),
  mainAnalysis.ReachableContext(?fromCtx, ?meth).

LeakingTaintedInformationVars(?fromCtx, ?from, ?toCtx, ?to) :-
  TaintedVarPointsTo(?value, ?toCtx, ?to),
  TaintSinkVar(_, _, ?toCtx, ?to),
  SourceFromTaintedValue(?value, ?source),
  AssignReturnValue(?source, ?from),
  TaintedVarPointsTo(?fromVal, ?fromCtx, ?from),
  SourceFromTaintedValue(?fromVal, ?source).

/**
 * Special Heap allocation on function call
 */
TaintedValueIntroduced(?declaringType, ?invo, ?type, ?label, ValueIdMacro(?invo, ?type, DEFAULT_BREADCRUMB)),
mainAnalysis.VarPointsTo(?hctx, ValueIdMacro(?invo, ?type, DEFAULT_BREADCRUMB), ?ctx, ?to) :-
  TaintSourceReturnInvocation(?label, ?ctx, ?invo),
  mainAnalysis.isImmutableHContext(?hctx),
  TypeForReturnValue(?type, ?to, ?invo),
  Instruction_Method(?invo, ?method),
  Method_DeclaringType(?method, ?declaringType).

// Formal-parameter source: taint the FORMAL parameter ?index of ?method directly,
// in the method's reachable context -- modelling an unmodeled caller (a framework /
// container) that invokes ?method with attacker-controlled data. This is the
// entry-point shape (e.g. a request handler whose argument is untrusted) that the
// return source above cannot express. The formal is seeded directly under
// ReachableContext (not via an actual->formal edge), and the tainted value is
// keyed by the formal so it is distinct per parameter source. Reference-typed
// parameters only; a primitive parameter source would need model-primitives.
TaintedValueIntroduced(?declaringType, ?formal, ?type, ?label, ValueIdMacro(?formal, ?type, DEFAULT_BREADCRUMB)),
mainAnalysis.VarPointsTo(?hctx, ValueIdMacro(?formal, ?type, DEFAULT_BREADCRUMB), ?ctx, ?formal) :-
  TaintSourceFormalParam(?label, ?index, ?method),
  FormalParam(?index, ?method, ?formal),
  mainAnalysis.ReachableContext(?ctx, ?method),
  mainAnalysis.isImmutableHContext(?hctx),
  Var_Type(?formal, ?type),
  isReferenceType(?type),
  Method_DeclaringType(?method, ?declaringType).

// Actual-parameter source: at each reachable call site of ?method, taint the
// ACTUAL at ?index -- the call filled the object the caller passed in. The value
// is typed by the actual's declared type and keyed by (call site, index) so it
// never collides with a return source on the same call. Flow-insensitive: the
// actual is tainted before and after the call alike.
TaintedValueIntroduced(?declaringType, ?srcId, ?type, ?label, ValueIdMacro(?srcId, ?type, DEFAULT_BREADCRUMB)),
mainAnalysis.VarPointsTo(?hctx, ValueIdMacro(?srcId, ?type, DEFAULT_BREADCRUMB), ?ctx, ?actual) :-
  TaintSourceActualParam(?label, ?index, ?method),
  MethodInvocationInContext(?ctx, ?invo, ?method),
  ActualParam(?index, ?invo, ?actual),
  ?srcId = cat(cat(?invo, "/actual"), to_string(?index)),
  Var_Type(?actual, ?type),
  mainAnalysis.isImmutableHContext(?hctx),
  Instruction_Method(?invo, ?inMethod),
  Method_DeclaringType(?inMethod, ?declaringType).

// Base source: at each reachable call site of ?method, taint the RECEIVER
// variable -- the call filled the object it was invoked on. Constructors
// (<init>) are the main use: the freshly allocated object is the receiver.
TaintedValueIntroduced(?declaringType, ?srcId, ?type, ?label, ValueIdMacro(?srcId, ?type, DEFAULT_BREADCRUMB)),
mainAnalysis.VarPointsTo(?hctx, ValueIdMacro(?srcId, ?type, DEFAULT_BREADCRUMB), ?ctx, ?base) :-
  TaintSourceBase(?label, ?method),
  MethodInvocationInContext(?ctx, ?invo, ?method),
  MethodInvocation_Base(?invo, ?base),
  ?srcId = cat(?invo, "/base"),
  Var_Type(?base, ?type),
  mainAnalysis.isImmutableHContext(?hctx),
  Instruction_Method(?invo, ?inMethod),
  Method_DeclaringType(?inMethod, ?declaringType).

// This source: taint `this` of ?method directly, in the method's reachable
// context -- the callee-side twin of the formal-parameter source, for a receiver
// built from untrusted data by an unmodeled caller.
TaintedValueIntroduced(?declaringType, ?this, ?type, ?label, ValueIdMacro(?this, ?type, DEFAULT_BREADCRUMB)),
mainAnalysis.VarPointsTo(?hctx, ValueIdMacro(?this, ?type, DEFAULT_BREADCRUMB), ?ctx, ?this) :-
  TaintSourceThis(?label, ?method),
  ThisVar(?method, ?this),
  mainAnalysis.ReachableContext(?ctx, ?method),
  mainAnalysis.isImmutableHContext(?hctx),
  Var_Type(?this, ?type),
  Method_DeclaringType(?method, ?declaringType).

// Mark half of the method-keyed sources. Each source above places a mock at its
// position; the rules below also MARK every AppMarkable object already at the
// position, with the same source id and label, so a holder of that object that
// never went through the position (a registry the factory stored it in, an alias
// taken before the call) is tainted too. Value-only marks, no hcontext, like the
// Field and Type marks. Primitive positions get this half only under
// model-primitives, where the position holds a markable primitive mock.
//
// Only positions in APPLICATION code are marked. At a library-internal position
// (a profile source called from inside the JDK, say) the objects present are
// whatever the library's own plumbing aliases there under a context-insensitive
// heap; marking them taints the application object wherever it lives. Observed:
// the minimal profile's Reader.read source, at its call site inside
// BufferedReader, held msgpack's length arithmetic object and marked it, which
// re-reported every readPayload finding under the profile's label. The mock is
// the right tool at such positions.
// Return: the objects the call returns, source id = the call site. Only for a
// source method that is itself application code: a library method's result, as
// the base analysis resolves it, can hold any application object the library's
// shared plumbing (collections, copies) ever held under a context-insensitive
// heap. Observed: Files.readAllBytes, called from Main, "returned" msgpack's own
// readPayload buffer through the ArrayList inside InputStream.readNBytes, and the
// mark tainted it. The mock is exact at such a position; the mark is noise.
TaintedValue(?value),
SourceFromTaintedValue(?value, ?invo),
LabelFromSource(?invo, ?label) :-
  TaintSourceReturnInvocation(?label, ?ctx, ?invo),
  Instruction_Method(?invo, ?inMethod),
  ApplicationMethod(?inMethod),
  MethodInvocation_Method(?invo, ?srcMethod),
  ApplicationMethod(?srcMethod),
  AssignReturnValue(?invo, ?to),
  mainAnalysis.VarPointsTo(_, ?value, ?ctx, ?to),
  AppMarkable(?value).

// Formal parameter: the objects callers pass, source id = the formal.
TaintedValue(?value),
SourceFromTaintedValue(?value, ?formal),
LabelFromSource(?formal, ?label) :-
  TaintSourceFormalParam(?label, ?index, ?method),
  ApplicationMethod(?method),
  FormalParam(?index, ?method, ?formal),
  mainAnalysis.VarPointsTo(_, ?value, _, ?formal),
  AppMarkable(?value).

// Actual parameter: the objects the actual holds at the call, source id = invo/actualN.
TaintedValue(?value),
SourceFromTaintedValue(?value, ?srcId),
LabelFromSource(?srcId, ?label) :-
  TaintSourceActualParam(?label, ?index, ?method),
  MethodInvocationInContext(?ctx, ?invo, ?method),
  Instruction_Method(?invo, ?inMethod),
  ApplicationMethod(?inMethod),
  ActualParam(?index, ?invo, ?actual),
  ?srcId = cat(cat(?invo, "/actual"), to_string(?index)),
  mainAnalysis.VarPointsTo(_, ?value, ?ctx, ?actual),
  AppMarkable(?value).

// Base: the receiver objects at the call, source id = invo/base.
TaintedValue(?value),
SourceFromTaintedValue(?value, ?srcId),
LabelFromSource(?srcId, ?label) :-
  TaintSourceBase(?label, ?method),
  MethodInvocationInContext(?ctx, ?invo, ?method),
  Instruction_Method(?invo, ?inMethod),
  ApplicationMethod(?inMethod),
  MethodInvocation_Base(?invo, ?base),
  ?srcId = cat(?invo, "/base"),
  mainAnalysis.VarPointsTo(_, ?value, ?ctx, ?base),
  AppMarkable(?value).

// This: the objects `this` holds in the method, source id = the this var.
TaintedValue(?value),
SourceFromTaintedValue(?value, ?this),
LabelFromSource(?this, ?label) :-
  TaintSourceThis(?label, ?method),
  ApplicationMethod(?method),
  ThisVar(?method, ?this),
  mainAnalysis.VarPointsTo(_, ?value, _, ?this),
  AppMarkable(?value).

// Field source, mock half: one mock per field, named by the field signature and
// typed by the field's declared type, placed in the field's points-to set. Loads
// need no rule of their own: the ordinary load rules move it into every variable
// the field is read into. Placed unconditionally (next to any real contents): "the
// field is empty" is a negation over a relation this very head extends, and a
// field assigned in a constructor can still be overwritten from outside.
// Static field: one tuple.
TaintedValueIntroduced(?declaringType, ?field, ?type, ?label, ValueIdMacro(?field, ?type, DEFAULT_BREADCRUMB)),
mainAnalysis.StaticFieldPointsTo(?hctx, ValueIdMacro(?field, ?type, DEFAULT_BREADCRUMB), ?field) :-
  TaintSourceField(?label, ?field),
  Field_Modifier("static", ?field),
  Field_Type(?field, ?type),
  Field_DeclaringType(?field, ?declaringType),
  mainAnalysis.isImmutableHContext(?hctx).

// Instance field: one tuple per base object that some reachable load of the
// field dereferences (the only base objects through which the field is ever read).
TaintedValueIntroduced(?declaringType, ?field, ?type, ?label, ValueIdMacro(?field, ?type, DEFAULT_BREADCRUMB)),
mainAnalysis.InstanceFieldPointsTo(?hctx, ValueIdMacro(?field, ?type, DEFAULT_BREADCRUMB), ?field, ?baseHctx, ?baseValue) :-
  TaintSourceField(?label, ?field),
  !Field_Modifier("static", ?field),
  mainAnalysis.LoadHeapInstanceField(_, _, ?field, ?baseHctx, ?baseValue),
  Field_Type(?field, ?type),
  Field_DeclaringType(?field, ?declaringType),
  mainAnalysis.isImmutableHContext(?hctx).

// Field source, mark half: every Markable object the field holds carries the
// taint itself, so aliases of it that never go through the field are tainted too.
TaintedValue(?value),
SourceFromTaintedValue(?value, ?field),
LabelFromSource(?field, ?label) :-
  TaintSourceField(?label, ?field),
  ( mainAnalysis.StaticFieldPointsTo(_, ?value, ?field) ;
    mainAnalysis.InstanceFieldPointsTo(_, ?value, ?field, _, _) ),
  Markable(?value).

// Type source, mark half: every Markable object of the type or a subtype carries
// the taint, with the type as source id. Markable already excludes minted taint
// stand-ins (not heap values) and shared representatives, so a type source on
// java.lang.String marks real string allocations but never <<string-constant>>.
TaintedValue(?value),
SourceFromTaintedValue(?value, ?type),
LabelFromSource(?type, ?label) :-
  TaintSourceType(?label, ?type),
  basic.SubtypeOf(?valueType, ?type),
  mainAnalysis.Value_Type(?value, ?valueType),
  Markable(?value).

#ifndef INFORMATION_FLOW_DISABLE_TYPE_MOCKS
// Type source, mock half: a stand-in at every ENTRY POSITION of the type, i.e.
// where a value declared as the type (or a subtype) arrives from code the
// analysis does not see. These are the positional sources applied by declared
// type: the stand-in is named by its position (suffix "/type", so it never
// collides with a positional source on the same position) and typed by the
// position's declared type, but its source id is the TYPE, like the marks. One
// stand-in per position however many type sources cover it. Reference types only.
//
// Entry position 1: a formal of a reachable method, declared as the type.
TaintedValueIntroduced(?declaringType, ?type, ?formalType, ?label, ValueIdMacro(cat(?formal, "/type"), ?formalType, DEFAULT_BREADCRUMB)),
mainAnalysis.VarPointsTo(?hctx, ValueIdMacro(cat(?formal, "/type"), ?formalType, DEFAULT_BREADCRUMB), ?ctx, ?formal) :-
  TaintSourceType(?label, ?type),
  basic.SubtypeOf(?formalType, ?type),
  isReferenceType(?formalType),
  Var_Type(?formal, ?formalType),
  FormalParam(_, ?method, ?formal),
  mainAnalysis.ReachableContext(?ctx, ?method),
  mainAnalysis.isImmutableHContext(?hctx),
  Method_DeclaringType(?method, ?declaringType).

// Entry position 2: a field declared as the type. Static: one tuple. Instance:
// one per base object some reachable load dereferences, as for TaintSourceField.
TaintedValueIntroduced(?declaringType, ?type, ?fieldType, ?label, ValueIdMacro(cat(?field, "/type"), ?fieldType, DEFAULT_BREADCRUMB)),
mainAnalysis.StaticFieldPointsTo(?hctx, ValueIdMacro(cat(?field, "/type"), ?fieldType, DEFAULT_BREADCRUMB), ?field) :-
  TaintSourceType(?label, ?type),
  basic.SubtypeOf(?fieldType, ?type),
  isReferenceType(?fieldType),
  Field_Type(?field, ?fieldType),
  Field_Modifier("static", ?field),
  Field_DeclaringType(?field, ?declaringType),
  mainAnalysis.isImmutableHContext(?hctx).

TaintedValueIntroduced(?declaringType, ?type, ?fieldType, ?label, ValueIdMacro(cat(?field, "/type"), ?fieldType, DEFAULT_BREADCRUMB)),
mainAnalysis.InstanceFieldPointsTo(?hctx, ValueIdMacro(cat(?field, "/type"), ?fieldType, DEFAULT_BREADCRUMB), ?field, ?baseHctx, ?baseValue) :-
  TaintSourceType(?label, ?type),
  basic.SubtypeOf(?fieldType, ?type),
  isReferenceType(?fieldType),
  Field_Type(?field, ?fieldType),
  !Field_Modifier("static", ?field),
  mainAnalysis.LoadHeapInstanceField(_, _, ?field, ?baseHctx, ?baseValue),
  Field_DeclaringType(?field, ?declaringType),
  mainAnalysis.isImmutableHContext(?hctx).

// Entry position 3: the result of a reachable call whose DECLARED target has no
// body in the facts (native, abstract or interface method, phantom method) and
// returns the type. The call's declared target, not its resolved callees: when
// resolution finds a body the stand-in sits next to the real results, when it
// finds none (an interface with no visible implementation) it is all there is.
TaintedValueIntroduced(?declaringType, ?type, ?retType, ?label, ValueIdMacro(cat(?invo, "/type"), ?retType, DEFAULT_BREADCRUMB)),
mainAnalysis.VarPointsTo(?hctx, ValueIdMacro(cat(?invo, "/type"), ?retType, DEFAULT_BREADCRUMB), ?ctx, ?to) :-
  TaintSourceType(?label, ?type),
  basic.SubtypeOf(?retType, ?type),
  isReferenceType(?retType),
  Method_ReturnType(?method, ?retType),
  !Instruction_Method(_, ?method),
  AnyMethodInvocation(?invo, ?method),
  AssignReturnValue(?invo, ?to),
  Instruction_Method(?invo, ?inMethod),
  mainAnalysis.ReachableContext(?ctx, ?inMethod),
  mainAnalysis.isImmutableHContext(?hctx),
  Method_DeclaringType(?inMethod, ?declaringType).
#endif // INFORMATION_FLOW_DISABLE_TYPE_MOCKS

#ifdef MODEL_PRIMITIVES
// Arithmetic (limitation C): the result of a binop/unop with a tainted operand
// carries the operand's taint. Under model-primitives the result variable already
// points to the site's own <prim-arith> object, which is Markable, so the result
// is MARKED: no value is minted, no breadcrumb is needed, and the mark survives
// whatever the ordinary flow rules do with the object afterwards. Scoped to
// APPLICATION code: a library arithmetic site (Integer.parseInt, Math.max, ...)
// has one object for every caller, context-insensitively, so marking it would
// taint every user of the helper program-wide (the explosion seen in C).
TaintedValue(?arithObj),
SourceFromTaintedValue(?arithObj, ?source) :-
  mainAnalysis.PrimitiveArithmeticSite(?insn, ?to, ?method, _),
  ApplicationMethod(?method),
  AssignOper_From(?insn, _, ?from),
  TaintedVarPointsTo(?tv, ?ctx, ?from),
  SourceFromTaintedValue(?tv, ?source),
  mainAnalysis.VarPointsTo(_, ?arithObj, ?ctx, ?to),
  Markable(?arithObj).
#endif // MODEL_PRIMITIVES

TaintedVarPointsTo(?value, ?ctx, ?var) :-
  TaintedValue(?value),
  mainAnalysis.VarPointsTo(_, ?value, ?ctx, ?var).


// Generic string internal tainting
#ifdef INFORMATION_FLOW_HIGH_SOUNDNESS
TaintedValue(?basevalue) :-
  TaintedValue(?value),
  mainAnalysis.InstanceFieldPointsTo(_, ?value, "<java.lang.String: char[] value>", _, ?basevalue).

TaintedValueTransferred(?declaringType, ?source, "char[]", ValueIdMacro(?source, "char[]", DEFAULT_BREADCRUMB)),
mainAnalysis.VarPointsTo(?hctx, ValueIdMacro(?source, "char[]", DEFAULT_BREADCRUMB), ?ctx, ?to) :-
  mainAnalysis.LoadHeapInstanceField(?ctx, ?to, "<java.lang.String: char[] value>", _, ?basevalue),
  TaintedValue(?basevalue),
  mainAnalysis.Value_DeclaringType(?basevalue, ?declaringType),
  SourceFromTaintedValue(?basevalue, ?source),
  mainAnalysis.isImmutableHContext(?hctx).
  .plan 1:(2,1,3,4,5)

#endif // INFORMATION_FLOW_HIGH_SOUNDNESS

// Serialization
.decl SerializeObjectInvocation(?base:Var, ?ctx:mainAnalysis.configuration.Context, ?var:Var)

SerializeObjectInvocation(?base, ?ctx, ?var) :-
  MethodInvocationInContextInApplication(?ctx, ?invocation, "<java.io.ObjectOutputStream: void writeObject(java.lang.Object)>"),
  MethodInvocation_Base(?invocation, ?base),
  ActualParam(_, ?invocation, ?var).

.decl ObjectSerializedToBase(?ctx:mainAnalysis.configuration.Context, ?base:Var, ?obj:Value)

ObjectSerializedToBase(?ctx, ?base, ?obj) :-
  SerializeObjectInvocation(?base, ?ctx, ?var),
  mainAnalysis.VarPointsTo(_, ?obj, ?ctx, ?var),
  SerializableValue(?obj).

.decl SerializableValue(?obj:Value)

SerializableValue(?obj) :-
   mainAnalysis.Value_Type(?obj, ?type),
   basic.SupertypeOf("java.io.Serializable", ?type).

.decl SerializableVar(?var:Var)

SerializableVar(?var) :-
   Var_Type(?var, ?type),
   basic.SupertypeOf("java.io.Serializable", ?type).

TaintedObjectSerialized(?declaringType, ?source, ?type, ?hctx, ValueIdMacro(?source, ?type, DEFAULT_BREADCRUMB), ?ctx, ?base) :-
  ObjectSerializedToBase(?ctx, ?base, ?baseobj),
  (mainAnalysis.InstanceFieldPointsTo(_, ?obj, ?field, _, ?baseobj),
  !Field_Modifier("transient", ?field)),
  TaintedValue(?obj),
  Var_Type(?base, ?type),
  mainAnalysis.Value_DeclaringType(?obj, ?declaringType),
  SourceFromTaintedValue(?obj, ?source),
  mainAnalysis.isImmutableHContext(?hctx).
  .plan 2: (3,2,1,4,5,6,7)

TaintedValueTransferred(?declaringType, ?source, ?type, ?val),
mainAnalysis.VarPointsTo(?hctx, ?val, ?ctx, ?base) :-
    TaintedObjectSerialized(?declaringType, ?source, ?type, ?hctx, ?val, ?ctx, ?base).

VarIsTaintedFromValue(?type, ?basevalue, ?ctx, ?to) :-
   MaybeDeserializedValue(?basevalue),
   TaintedVarPointsTo(?basevalue, ?ctx, ?base),
   LoadInstanceField(?base, ?sig, ?to, _),
   !Field_Modifier("transient", ?sig),
   Var_Type(?to, ?type).

TaintTransferBaseToReturn("<java.io.ObjectInputStream: java.lang.Object readObject()>").

.decl OptDeserializeInvoke(?ret:Var)

OptDeserializeInvoke(?ret) :-
   MethodInvocationInContextInApplication(_, ?invocation, "<java.io.ObjectInputStream: java.lang.Object readObject()>"),
   AssignReturnValue(?invocation, ?ret).

.decl MaybeDeserializedValue(?value:Value)

MaybeDeserializedValue(?value) :-
   OptDeserializeInvoke(?ret),
   TaintedVarPointsTo(?value, _, ?ret),
   SerializableValue(?value).

.decl AppTaintedVarPointsTo(?value:Value, ?var:Var)
AppTaintedVarPointsTo(?value, ?var) :-
  TaintedVarPointsTo(?value, _, ?var), ApplicationVar(?var).

.decl AppTaintedVar(?var:Var)
.output AppTaintedVar
AppTaintedVar(?var) :- AppTaintedVarPointsTo(_, ?var).

// Rules for tracking taint object flow (from/to var and context)
TaintObjTransfer(?callerCtx, ?actual, ?calleeCtx, ?formal) :-
    mainAnalysis.OptArgAssign(?calleeCtx, ?formal, ?callerCtx, ?actual, ?allowedType),
    TaintedVarPointsTo(?taintedValue, ?callerCtx, ?actual),
    mainAnalysis.Value_Type(?taintedValue, ?tType),
    basic.SubtypeOf(?tType, ?allowedType).

TaintObjTransfer(?callerCtx, ?return, ?calleeCtx, ?local) :-
    mainAnalysis.CallGraphEdge(?callerCtx, ?invocation, ?calleeCtx, ?method),
    AssignReturnValue(?invocation, ?local),
    ReturnVar(?return, ?method),
    TaintedVarPointsTo(_, ?calleeCtx, ?return).

TaintObjTransfer(?ctx, ?base, ?calleeCtx, ?this) :-
    TaintedVarPointsTo(_, ?ctx, ?base),
    MethodInvocation_Base(?invo, ?base),
    mainAnalysis.CallGraphEdge(?ctx, ?invo, ?calleeCtx, ?meth),
    ThisVar(?meth, ?this).
.plan 1:(3,2,1,4)

TaintObjTransfer(?ctx, ?param, ?ctx, ?base) :-
    ParamTaintTransferredToBase(?param, ?ctx, ?base),
    TaintedVarPointsTo(_, ?ctx, ?param).

TaintObjTransfer(?fromCtx, ?from, ?toCtx, ?to) :-
    TaintedVarPointsTo(_, ?fromCtx, ?from),
    mainAnalysis.StoreHeapInstanceField(?sig, ?hctx, ?baseval, ?fromCtx, ?from),
    mainAnalysis.LoadHeapInstanceField(?toCtx, ?to, ?sig, ?hctx, ?baseval).
.plan 1:(2,1,3),2:(3,2,1)

TaintObjTransfer(?fromCtx, ?from, ?toCtx, ?to) :-
    TaintedVarPointsTo(_, ?fromCtx, ?from),
    mainAnalysis.StoreHeapArrayIndex(?basehctx, ?basevalue, ?fromCtx, ?from),
    mainAnalysis.LoadHeapArrayIndex(?toCtx, ?to, ?basehctx, ?basevalue).
.plan 1:(2,1,3),2:(3,2,1)

TaintObjTransfer(?fromCtx, ?from, ?toCtx, ?to) :-
    TaintedVarPointsTo(?val, ?toCtx, ?to),
    LoadStaticField(?sig, ?to, _),
    StoreStaticField(?from, ?sig, _),
    TaintedVarPointsTo(?val, ?fromCtx, ?from).
.plan 1:(4,3,2,1)

TaintObjTransfer(?ctx, ?from, ?ctx, ?to) :-
    TaintedVarPointsTo(_, ?ctx, ?from),
    AssignCast(_, ?from, ?to, _).

TaintObjTransfer(?ctx, ?from, ?ctx, ?to) :-
    TaintedVarPointsTo(_, ?ctx, ?from),
    AssignLocal(?from, ?to, _).

#endif // DISABLE_POINTS_TO
