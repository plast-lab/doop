#include "common-transfer-methods.dl"

TaintSourceReturnPattern("default", "<javax.servlet.ServletRequest: .* get.*[(].*[)]>").
TaintSourceReturnPattern("default", "<javax.servlet.ServletContext: .* get.*[(].*[)]>").
TaintSourceReturnPattern("default", "<javax.servlet.ServletConfig: .* get.*[(].*[)]>").
TaintSourceReturnPattern("default", "<javax.servlet.http.Cookie: .* get.*[(].*[)]>").
TaintSourceReturnPattern("default", "<javax.servlet.http.HttpServletRequest: .* get.*[(].*[)]>").
TaintSourceReturnPattern("default", "<javax.servlet.http.HttpSession: .* get.*[(].*[)]>").
TaintSourceReturnPattern("default", "<javax.servlet.ServletRequest: .* get.*[(].*[)]>").
TaintSourceReturnPattern("default", "<java.io.BufferedReader: java.lang.String readLine[(][)]>").
TaintSourceReturnPattern("default", "<java.io.BufferedReader: java.lang.String readLine[(]boolean[)]>").
TaintSourceReturnPattern("default", "<java.net.URLDecoder: java.lang.String decode[(]java.lang.String,java.lang.String[)]>").
TaintSourceReturnPattern("default", "<com.oreilly.servlet.MultipartRequest: java.lang.String getParameter[(]java.lang.String[)]>").
TaintSourceReturnPattern("default", "<javax.servlet.http.HttpServletResponse: java.io.PrintWriter getWriter[(][)]>").
TaintSinkActualParamPattern("default", 0, "<java.io.Print.*: void println[(].*[)]>").
TaintSinkActualParamPattern("default", 0, "<java.sql.Statement: .* execute.*[(].*[)]>").
TaintSinkActualParamPattern("default", 0, "<javax.servlet.http.HttpServletResponse: void sendRedirect[(].*[)]>").
TaintSinkActualParamPattern("default", 0, "<java.io.File: void <init>[(].*[)]>").
TaintSinkActualParamPattern("default", 0, "<java.io.File.*er: void <init>[(].*[)]>").
TaintSinkActualParamPattern("default", 0, "<java.io.File.*Stream: void <init>[(].*[)]>").
TaintSinkActualParamPattern("default", 0, "<java.sql.Connection: java.sql.PreparedStatement prepareStatement[(].*[)]>").

TaintSourceReturn(?label, ?overriddenMethod) :-
   TaintSourceReturn(?label, ?method),
   Method_DeclaringType(?method, ?superclass),
   Method_SimpleName(?method, ?name),
   Method_Descriptor(?method, ?descriptor),
   basic.SubtypeOf(?class, ?superclass),
   isClassType(?class),
   Method_DeclaringType(?overriddenMethod, ?class),
   Method_SimpleName(?overriddenMethod, ?name),
   Method_Descriptor(?overriddenMethod, ?descriptor).

TaintSinkActualParam(?label, ?n, ?overriddenMethod) :-
   TaintSinkActualParam(?label, ?n, ?method),
   Method_DeclaringType(?method, ?superclass),
   Method_SimpleName(?method, ?name),
   Method_Descriptor(?method, ?descriptor),
   basic.SubtypeOf(?class, ?superclass),
   isClassType(?class),
   Method_DeclaringType(?overriddenMethod, ?class),
   Method_SimpleName(?overriddenMethod, ?name),
   Method_Descriptor(?overriddenMethod, ?descriptor).


TaintSanitizer(?method) :-
  (?method = "<securibench.micro.sanitizers.Sanitizers1: java.lang.String clean(java.lang.String)>" ;
   ?method = "<securibench.micro.sanitizers.Sanitizers2: java.lang.String clean(java.lang.String)>" ;
   ?method = "<java.net.URLEncoder: java.lang.String encode(java.lang.String,java.lang.String)>" ;
   ?method = "<securibench.micro.sanitizers.Sanitizers6: java.lang.String clean(java.lang.String)>"),
  isMethod(?method).
