#include "common-transfer-methods.dl"

// Spring-specific sources-sinks-sanitizers. Entries are plain facts: a method
// that does not exist in the analysed program is then visible to the spec
// diagnostics (TaintSpecUnmatched), instead of being dropped by an isMethod
// guard; every consumer joins the program anyway.
TaintSinkActualParamPattern("default", 0, "<javax.servlet.jsp.JspWriter: void print[(].*[)]>").
TaintSinkActualParamPattern("default", 0, "<javax.servlet.jsp.JspWriter: void println[(].*[)]>").
TaintSinkActualParamPattern("default", 0, "<java.io.Writer: void write[(].*[)]>").
TaintSinkActualParamPattern("default", 0, "<java.io.Writer: java.io.Writer append[(].*[)]>").
// "javax.servlet.http.HttpServletResponse([C)V"])" // TODO it's an interface?
TaintSinkActualParamPattern("default", 0, "<java.io.PrintWriter: void write[(].*[)]>").
TaintSinkActualParamPattern("default", 0, "<java.io.PrintWriter: java.io.Writer append[(].*[)]>").
TaintSinkActualParamPattern("default", 0, "<java.io.PrintWriter: void print[(].*[)]>").
TaintSinkActualParamPattern("default", 0, "<java.io.PrintWriter: void println[(].*[)]>").
TaintSinkActualParamPattern("default", 0, "<java.sql.Statement: void addBatch[(]java.lang.String[)]>").
TaintSinkActualParamPattern("default", 0, "<java.sql.Statement: int executeUpdate[(].*[)]>").
TaintSinkActualParamPattern("default", 0, "<java.sql.Statement: boolean execute[(].*[)]>").
TaintSinkActualParamPattern("default", 0, "<java.sql.Statement: java.sql.ResultSet executeQuery[(].*[)]>").
TaintSinkActualParamPattern("default", 0, "<java.sql.Connection: java.sql.PreparedStatement prepareStatement[(].*[)]>").
TaintSinkActualParamPattern("default", 0, "<java.sql.Connection: java.sql.CallableStatement prepareCall[(].*[)]>").
TaintSinkActualParamPattern("default", 0, "<java.sql.PreparedStatement: void setString[(].*[)]>").


.decl TaintSanitizerIffBaseUntainted(?meth: Method)

TaintSanitizer("<java.net.URLEncoder: java.lang.String encode(java.lang.String)>").
TaintSanitizer("<java.net.URLEncoder: java.lang.String encode(java.lang.String,java.lang.String)>").
TaintSanitizer("<org.apache.catalina.util.URLEncoder: java.lang.String encode(java.lang.String,java.lang.String)>").
TaintSanitizer(?method) :- TaintSanitizerIffBaseUntainted(?method).

TaintSanitizer(?overriddenMethod) :-
   TaintSanitizer(?method),
   Method_DeclaringType(?method, ?superclass),
   Method_SimpleName(?method, ?name),
   Method_Descriptor(?method, ?descriptor),
   basic.SubtypeOf(?class, ?superclass),
   isClassType(?class),
   Method_DeclaringType(?overriddenMethod, ?class),
   Method_SimpleName(?overriddenMethod, ?name),
   Method_Descriptor(?overriddenMethod, ?descriptor).

TaintSanitizerIffBaseUntainted("<java.util.Properties: java.lang.String getProperty(java.lang.String)>").
TaintSanitizerIffBaseUntainted("<java.util.Hashtable: java.lang.Object get(java.lang.Object)>").
TaintSanitizerIffBaseUntainted("<java.util.Map: java.lang.Object get(java.lang.Object)>").
TaintSanitizerIffBaseUntainted("<java.util.HashMap: java.lang.Object get(java.lang.Object)>").

TaintSanitizerIffBaseUntainted(?overriddenMethod) :-
   TaintSanitizerIffBaseUntainted(?method),
   Method_DeclaringType(?method, ?superclass),
   Method_SimpleName(?method, ?name),
   Method_Descriptor(?method, ?descriptor),
   basic.SubtypeOf(?class, ?superclass),
   isClassType(?class),
   Method_DeclaringType(?overriddenMethod, ?class),
   Method_SimpleName(?overriddenMethod, ?name),
   Method_Descriptor(?overriddenMethod, ?descriptor).

TaintTransferBaseToReturn(?method) :- TaintSanitizerIffBaseUntainted(?method).

TaintSanitizer(?method) :- TaintSinkActualParam(_, _, ?method).

TaintSourceReturn("default", "<javax.servlet.ServletRequest: java.lang.String getParameter(java.lang.String)>").
TaintSourceReturn("default", "<javax.servlet.ServletRequest: java.lang.String getHeader(java.lang.String)>").
TaintSourceReturn("default", "<javax.servlet.ServletRequest: java.lang.String[] getParameterValues(java.lang.String)>").
TaintSourceReturn("default", "<javax.servlet.http.HttpServletRequest: javax.servlet.http.Cookie[] getCookies()>").
TaintSourceReturn("default", "<javax.servlet.http.HttpServletRequest: java.lang.String getHeader(java.lang.String)>").
TaintSourceReturn("default", "<javax.servlet.http.HttpServletRequest: java.util.Enumeration getHeaders(java.lang.String)>").
TaintSourceReturn("default", "<javax.servlet.http.HttpServletRequest: java.util.Enumeration getHeaderNames()>").
TaintSourceReturn("default", "<javax.servlet.http.HttpServletRequest: java.lang.String getPathInfo()>").
TaintSourceReturn("default", "<javax.servlet.http.HttpServletRequest: java.lang.String getPathTranslated()>").
TaintSourceReturn("default", "<javax.servlet.http.HttpServletRequest: java.lang.String getQueryString()>").
TaintSourceReturn("default", "<javax.servlet.http.HttpServletRequest: java.lang.String getRequestedSessionId()>").
TaintSourceReturn("default", "<javax.servlet.http.HttpServletRequest: java.lang.String getRequestURI()>").
TaintSourceReturn("default", "<javax.servlet.http.HttpServletRequest: java.lang.StringBuffer getRequestURL()>").
TaintSourceReturn("default", "<javax.servlet.http.HttpServletRequest: java.lang.String getServletPath()>").
TaintSourceReturn("default", "<javax.servlet.ServletRequest: java.lang.Object getAttribute(java.lang.String)>").
TaintSourceReturn("default", "<javax.servlet.ServletRequest: java.util.Enumeration getAttributeNames()>").
TaintSourceReturn("default", "<javax.servlet.ServletRequest: javax.servlet.ServletInputStream getInputStream()>").
TaintSourceReturn("default", "<javax.servlet.ServletRequest: java.util.Enumeration getParameterNames()>").
TaintSourceReturn("default", "<javax.servlet.ServletRequest: java.util.Map getParameterMap()>").
TaintSourceReturn("default", "<javax.servlet.ServletRequest: java.lang.String getServerName()>").
TaintSourceReturn("default", "<javax.servlet.ServletRequest: java.io.BufferedReader getReader()>").
TaintSourceReturn("default", "<javax.servlet.ServletRequest: java.lang.String getRemoteAddr()>").
TaintSourceReturn("default", "<javax.servlet.ServletRequest: java.lang.String getRemoteHost()>").


TaintTransferBaseToReturn("<java.lang.String: java.lang.CharSequence subSequence(int,int)>").

TaintTransferBaseToReturn("<java.util.Map: java.lang.Object get(java.lang.Object)>").
TaintTransferBaseToReturn("<javax.servlet.http.Cookie: java.lang.String getComment()>").
TaintTransferBaseToReturn("<javax.servlet.http.Cookie: java.lang.String getDomain()>").
TaintTransferBaseToReturn("<javax.servlet.http.Cookie: java.lang.String getName()>").
TaintTransferBaseToReturn("<javax.servlet.http.Cookie: java.lang.String getPath()>").
TaintTransferBaseToReturn("<javax.servlet.http.Cookie: java.lang.String getValue()>").
TaintTransferBaseToReturn("<java.io.BufferedReader: int read()>").
TaintTransferBaseToReturn("<java.io.BufferedReader: java.lang.String readLine(boolean)>").
TaintTransferBaseToReturn("<java.io.BufferedReader: java.lang.String readLine()>").
TaintTransferBaseToReturn("<java.util.Hashtable: java.lang.Object get(java.lang.Object)>").
TaintTransferBaseToReturn("<java.util.HashMap: java.lang.Object get(java.lang.Object)>").

TaintTransferBaseToActualParam("<javax.servlet.ServletInputStream: int readLine(byte[],int,int)>").
TaintTransferBaseToActualParam("<java.io.BufferedReader: int read1(char[],int,int)>").
TaintTransferBaseToActualParam("<java.io.BufferedReader: int read(char[],int,int)>").

TaintTransferActualParamToBase(1, "<java.util.HashMap: java.lang.Object put(java.lang.Object,java.lang.Object)>").
TaintTransferActualParamToBase(1, "<java.util.Map: java.lang.Object put(java.lang.Object,java.lang.Object)>").
TaintTransferActualParamToBase(1, "<java.util.Properties: java.lang.Object setProperty(java.lang.String,java.lang.String)>").
TaintTransferActualParamToBase(1, "<java.util.Hashtable: java.lang.Object put(java.lang.Object,java.lang.Object)>").

// (Override expansion of sources and sinks is the default, core.dl.)

// Params with these annotations introduce taint objects. (Until Nov 11 every
// method of the parameter's type was also declared a receiver->result transfer, so
// that getters on the stand-in yielded taint; deep taint -- a field load from a
// tainted base in application code -- now gives that, one level at a time.)
TaintedValueIntroduced(?declaringType, ?to, ?type, "default", ValueIdMacro(?to, ?type, DEFAULT_BREADCRUMB)),
mainAnalysis.VarPointsTo(?hctx, ValueIdMacro(?to, ?type, DEFAULT_BREADCRUMB), ?ctx, ?to) :-
  FormalParam(?idx, ?meth, ?to),
  (Param_Annotation(?meth, ?idx, "org.springframework.web.bind.annotation.RequestParam");
  Param_Annotation(?meth, ?idx, "org.springframework.web.bind.annotation.RequestBody");
  Param_Annotation(?meth, ?idx, "org.springframework.web.bind.annotation.PathVariable")),
  mainAnalysis.ReachableContext(?ctx, ?meth),
  Var_Type(?to, ?type),
  mainAnalysis.isImmutableHContext(?hctx),
  Method_DeclaringType(?meth, ?declaringType).

#ifdef OPEN_PROGRAMS

// Create context for entry point parameters
mainAnalysis.configuration.RecordContextRequest(?ctx, ValueIdMacro(?to, ?ctype, DEFAULT_BREADCRUMB), ?to) :-
  mainAnalysis.EntryPointMethod(?meth),
  FormalParam(_, ?meth, ?to),
  mainAnalysis.ReachableContext(?ctx, ?meth),
  Var_Type(?to, ?type),
  mainAnalysis.TypeToConcreteImplementation(?type, ?ctype).

// Introduce concrete taint values for entry point parameters (their contents
// follow through deep taint; the per-type transfer trick is gone, see above).
TaintedValueIntroduced(?declaringType, ?to, ?ctype, "default", ValueIdMacro(?to, ?ctype, DEFAULT_BREADCRUMB)),
mainAnalysis.VarPointsTo(?hctx, ValueIdMacro(?to, ?ctype, DEFAULT_BREADCRUMB), ?ctx, ?to) :-
  mainAnalysis.EntryPointMethod(?meth),
  Method_DeclaringType(?meth, ?declaringType),
  FormalParam(_, ?meth, ?to),
  mainAnalysis.ReachableContext(?ctx, ?meth),
  Var_Type(?to, ?type),
  mainAnalysis.TypeToConcreteImplementation(?type, ?ctype),
  mainAnalysis.configuration.RecordContextResponse(?ctx, ValueIdMacro(?to, ?ctype, DEFAULT_BREADCRUMB), ?to, ?hctx).

#endif // OPEN_PROGRAMS
