/***************************************************
 * Methods
 ***************************************************/

// Count how many contexts, a reachable method appears with
#ifdef FLOWLOG_ENGINE
Stats_MethodContextCount(?method, count(?ctx)) :-
  mainAnalysis.ReachableContext(?ctx, ?method).
#else
Stats_MethodContextCount(?method, ?n) :-
  mainAnalysis.ReachableContext(_, ?method),
  ?n = count : mainAnalysis.ReachableContext(_, ?method).
#endif // FLOWLOG_ENGINE

#ifdef FLOWLOG_ENGINE
.decl _Agg_Stats_Methods(?n:number)
_Agg_Stats_Methods(count(?method)) :-
  mainAnalysis.Reachable(?method).
Stats_Methods(?n) :- _Agg_Stats_Methods(?n).
Stats_Methods(0) :- _StatsSeed(_), !_Agg_Stats_Methods(_).
#else
Stats_Methods(?n) :-
  ?n = count : mainAnalysis.Reachable(_).
#endif // FLOWLOG_ENGINE

#ifdef FLOWLOG_ENGINE
Method_NumberOfContexts(?method, count(?ctx)) :-
  mainAnalysis.Reachable(?method),
  mainAnalysis.ReachableContext(?ctx, ?method).
#else
Method_NumberOfContexts(?method, ?n) :-
  mainAnalysis.Reachable(?method),
  ?n =  count : {mainAnalysis.ReachableContext(_, ?method)}.
#endif // FLOWLOG_ENGINE

#ifdef FLOWLOG_ENGINE
.decl _Agg_Method_VPTCountPerMethodVariable(?method:Method, ?var:Var, ?n:number)
_Agg_Method_VPTCountPerMethodVariable(?method, ?var, count((?hctx, ?value, ?ctx))) :-
  Var_DeclaringMethod(?var, ?method),
  mainAnalysis.VarPointsTo(?hctx, ?value, ?ctx, ?var).
Method_VPTCountPerMethodVariable(?method, ?var, ?n) :-
  _Agg_Method_VPTCountPerMethodVariable(?method, ?var, ?n).
Method_VPTCountPerMethodVariable(?method, ?var, 0) :-
  Var_DeclaringMethod(?var, ?method),
  !_Agg_Method_VPTCountPerMethodVariable(?method, ?var, _).
#else
Method_VPTCountPerMethodVariable(?method, ?var, Y) :-
  Var_DeclaringMethod(?var, ?method),
  Y =  count : {mainAnalysis.VarPointsTo(_, _, _, ?var)}.
#endif // FLOWLOG_ENGINE

// NOTE: FlowLog's sum(x) adds up the DISTINCT values of x, where Souffle adds up
// one value per witness row, so summing the per-variable counts would collapse
// every variable of a method that shares a points-to set size with another --
// and most share 0. There is no tuple form to fall back on, as there is for
// count: sum of a tuple is rejected outright. The sum is not needed though. The
// total is just how many points-to facts the method's variables have between
// them, which the join below counts directly, so the two branches agree.
//
// NOTE: The branches reach the same number by different routes. Souffle sums
// Method_VPTCountPerMethodVariable; FlowLog recomputes from Var_DeclaringMethod
// and VarPointsTo. Change how the per-variable counts are derived and the two
// will drift apart silently -- keep this rule in step with that one.
#ifdef FLOWLOG_ENGINE
.decl _Agg_Method_TotalVPT(?method:Method, ?n:number)
_Agg_Method_TotalVPT(?method, count((?var, ?hctx, ?value, ?ctx))) :-
  mainAnalysis.Reachable(?method),
  Var_DeclaringMethod(?var, ?method),
  mainAnalysis.VarPointsTo(?hctx, ?value, ?ctx, ?var).
Method_TotalVPT(?method, ?n) :-
  _Agg_Method_TotalVPT(?method, ?n).
// Covers both Souffle zero cases: a method whose variables all count zero, and
// a method with no variables at all.
Method_TotalVPT(?method, 0) :-
  mainAnalysis.Reachable(?method),
  !_Agg_Method_TotalVPT(?method, _).
#else
Method_TotalVPT(?method, Y) :-
  mainAnalysis.Reachable(?method),
  Y = sum ?n : {Method_VPTCountPerMethodVariable(?method, _, ?n)}.

Method_TotalVPT(?method, 0) :-
  mainAnalysis.Reachable(?method),
  !Var_DeclaringMethod(_, ?method).
#endif // FLOWLOG_ENGINE

