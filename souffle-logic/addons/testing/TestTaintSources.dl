// ============================================================================
// Test queries for the P/Taint source vocabulary (addons/information-flow):
// TaintSourceReturn, TaintSourceFormalParam, TaintSourceActualParam,
// TaintSourceBase, TaintSourceThis, TaintSourceField, TaintSourceType (mark and
// mock halves) and the default override expansion, driven by
// tests/117-taint-sources (class Main).
//
// Loaded via --extra-logic on top of --information-flow minimal, so it also
// carries the taint SPEC for the driver. Every check is a FAIL relation that
// must be EMPTY when the feature works; the Groovy spec asserts each with
// relationIsEmpty. Checks anchor on the producing / consuming method of each
// sink argument (stable source signatures), never on invocation numbering.
// ============================================================================

// ---- the spec for the driver ------------------------------------------------
TaintSourceReturn("src",   "<Main: java.lang.String untrusted()>").
TaintSourceReturn("src",   "<Main$Reader: java.lang.String read()>").
TaintSourceReturn("prim",  "<Main: int untrustedInt()>").
TaintSourceFormalParam("param", 0, "<Main: void handle(java.lang.String)>").
TaintSinkActualParam("sink", 0, "<Main: void sink(java.lang.String)>").
TaintSinkActualParam("sink", 1, "<Main: void sink2(java.lang.String,java.lang.String)>").
TaintSinkActualParam("sink", 0, "<Main: void sinkInt(int)>").
TaintSourceActualParam("arg",  0, "<Main: int read(byte[])>").
TaintSourceBase("base", "<Main$Props: void load()>").
TaintSourceBase("ctor", "<Main$Conn: void <init>(java.lang.String)>").
TaintSourceThis("this", "<Main$Request: void validate()>").
TaintSinkActualParam("sink", 0, "<Main: void sinkBytes(byte[])>").
TaintSinkActualParam("sink", 0, "<Main: void sinkObj(java.lang.Object)>").
TaintSinkActualParam("sink", 0, "<Main: void sinkByte(byte)>").
TaintSinkActualParam("sink", 0, "<Main: void sinkBytesNeg(byte[])>").
TaintSinkActualParam("sink", 0, "<Main: void sinkObjNeg(java.lang.Object)>").
TaintSourceField("field", "<Main: java.lang.String CONFIG>").
TaintSourceField("field", "<Main$Settings: java.lang.String name>").
TaintSourceField("field", "<Main$Settings: java.lang.String external>").
TaintSourceField("field", "<Main$Settings: byte[] data>").
TaintSourceType("type", "Main$Token").
TaintSourceType("type", "Main$Session").

// ---- shared helpers ---------------------------------------------------------

// Guard against typos in the spec above: every named method must exist.
.decl Taint_FAIL_SpecUnmatched(?m:symbol)
.output Taint_FAIL_SpecUnmatched
Taint_FAIL_SpecUnmatched(?m) :- TaintSourceReturn(_, ?m),         !isMethod(?m).
Taint_FAIL_SpecUnmatched(?m) :- TaintSourceFormalParam(_, _, ?m), !isMethod(?m).
Taint_FAIL_SpecUnmatched(?m) :- TaintSinkActualParam(_, _, ?m),   !isMethod(?m).
Taint_FAIL_SpecUnmatched(?m) :- TaintSourceActualParam(_, _, ?m), !isMethod(?m).
Taint_FAIL_SpecUnmatched(?m) :- TaintSourceBase(_, ?m),           !isMethod(?m).
Taint_FAIL_SpecUnmatched(?m) :- TaintSourceThis(_, ?m),           !isMethod(?m).
Taint_FAIL_SpecUnmatched(?f) :- TaintSourceField(_, ?f),          !isField(?f).
Taint_FAIL_SpecUnmatched(?t) :- TaintSourceType(_, ?t),           !isType(?t).

// A call to a declared sink method, with the actual at the sink index.
.decl SinkCall(?invo:symbol, ?sinkMethod:symbol, ?actual:symbol)
SinkCall(?invo, ?m, ?actual) :-
  TaintSinkActualParam(_, ?idx, ?m),
  MethodInvocation_Method(?invo, ?m),
  ActualParam(?idx, ?invo, ?actual).

// The sink actual of ?invo is the result of a call to ?producer (declared target).
.decl SinkFedBy(?invo:symbol, ?producer:symbol)
SinkFedBy(?invo, ?producer) :-
  SinkCall(?invo, _, ?actual),
  AssignReturnValue(?srcInvo, ?actual),
  MethodInvocation_Method(?srcInvo, ?producer).

// Debug dump (not asserted): every leak reported.
.decl TaintTest_Leaks(?from:symbol, ?to:symbol, ?invo:symbol, ?source:symbol)
.output TaintTest_Leaks
TaintTest_Leaks(?from, ?to, ?invo, ?source) :-
  LeakingTaintedInformation(?from, ?to, _, ?invo, ?source).

.decl LeakAt(?from:symbol, ?invo:symbol)
LeakAt(?from, ?invo) :- TaintTest_Leaks(?from, "sink", ?invo, _).

// ---- return source ------------------------------------------------------------
// Every sink fed by untrusted() must leak under label "src" (covers sink and the
// index-1 feed of sink2).
.decl Taint_FAIL_ReturnSourceMissing(?invo:symbol)
.output Taint_FAIL_ReturnSourceMissing
Taint_FAIL_ReturnSourceMissing(?invo) :-
  SinkFedBy(?invo, "<Main: java.lang.String untrusted()>"),
  !LeakAt("src", ?invo).

// ---- override expansion (default) ---------------------------------------------
// The source is declared on Reader.read; the call resolves to FileReader.read.
.decl Taint_FAIL_OverrideExpansionMissing(?invo:symbol)
.output Taint_FAIL_OverrideExpansionMissing
Taint_FAIL_OverrideExpansionMissing(?invo) :-
  SinkFedBy(?invo, "<Main$Reader: java.lang.String read()>"),
  !LeakAt("src", ?invo).

// ---- formal-parameter source -----------------------------------------------------
// The sink call inside handle must leak under label "param", attributed to
// handle's formal 0 as the source.
.decl HandleSinkLeaks()
HandleSinkLeaks() :-
  SinkCall(?invo, "<Main: void sink(java.lang.String)>", _),
  Instruction_Method(?invo, "<Main: void handle(java.lang.String)>"),
  FormalParam(0, "<Main: void handle(java.lang.String)>", ?formal),
  TaintTest_Leaks("param", "sink", ?invo, ?formal).

.decl Taint_FAIL_FormalParamSourceMissing(?msg:symbol)
.output Taint_FAIL_FormalParamSourceMissing
Taint_FAIL_FormalParamSourceMissing("no param-labelled leak at handle's sink call, sourced at its formal 0") :-
  !HandleSinkLeaks().

// ---- negatives --------------------------------------------------------------------
// A sink fed by trusted() must not leak: covers sink(trusted()) and
// sink2(untrusted(), trusted()), whose taint sits at the non-sink index 0.
// (handle's internal sink is fed by the formal, not by a call, so it is excluded.)
.decl Taint_FAIL_NonSourceLeaks(?invo:symbol, ?from:symbol)
.output Taint_FAIL_NonSourceLeaks
Taint_FAIL_NonSourceLeaks(?invo, ?from) :-
  SinkFedBy(?invo, "<Main: java.lang.String trusted()>"),
  LeakAt(?from, ?invo).

// Only the spec's labels may ever appear in a finding.
.decl Taint_FAIL_UnexpectedLabel(?from:symbol, ?to:symbol)
.output Taint_FAIL_UnexpectedLabel
Taint_FAIL_UnexpectedLabel(?from, ?to) :-
  TaintTest_Leaks(?from, ?to, _, _),
  ( ?to != "sink" ;
    (?from != "src", ?from != "param", ?from != "prim",
     ?from != "arg", ?from != "base", ?from != "ctor", ?from != "this",
     ?from != "field", ?from != "type") ).

// ---- primitive-typed return source ------------------------------------------
// An int-typed taint value must survive the actual->formal edge into sinkInt
// (no model-primitives needed: the value is minted with the primitive type and
// the edge's subtype check holds reflexively).
.decl Taint_FAIL_PrimSourceMissing(?invo:symbol)
.output Taint_FAIL_PrimSourceMissing
Taint_FAIL_PrimSourceMissing(?invo) :-
  SinkFedBy(?invo, "<Main: int untrustedInt()>"), !LeakAt("prim", ?invo).

// ---- actual-parameter source --------------------------------------------------
// The sinkBytes call must leak under "arg", sourced at read's actual 0 (source id
// = <read call site>/actual0).
.decl Taint_FAIL_ActualParamSourceMissing(?msg:symbol)
.output Taint_FAIL_ActualParamSourceMissing
.decl ActualParamSourceLeaks()
ActualParamSourceLeaks() :-
  SinkCall(?sinkInvo, "<Main: void sinkBytes(byte[])>", _),
  MethodInvocation_Method(?readInvo, "<Main: int read(byte[])>"),
  TaintTest_Leaks("arg", "sink", ?sinkInvo, cat(?readInvo, "/actual0")).
Taint_FAIL_ActualParamSourceMissing("sinkBytes(buf) did not leak from read(buf)'s actual 0") :-
  !ActualParamSourceLeaks().

// ---- base source (method and constructor) -----------------------------------------
.decl BaseSourceLeaks(?label:symbol)
BaseSourceLeaks("base") :-
  SinkCall(?sinkInvo, "<Main: void sinkObj(java.lang.Object)>", _),
  MethodInvocation_Method(?loadInvo, "<Main$Props: void load()>"),
  TaintTest_Leaks("base", "sink", ?sinkInvo, cat(?loadInvo, "/base")).
BaseSourceLeaks("ctor") :-
  SinkCall(?sinkInvo, "<Main: void sinkObj(java.lang.Object)>", _),
  MethodInvocation_Method(?initInvo, "<Main$Conn: void <init>(java.lang.String)>"),
  TaintTest_Leaks("ctor", "sink", ?sinkInvo, cat(?initInvo, "/base")).

.decl Taint_FAIL_BaseSourceMissing(?label:symbol)
.output Taint_FAIL_BaseSourceMissing
Taint_FAIL_BaseSourceMissing("base") :- !BaseSourceLeaks("base").
Taint_FAIL_BaseSourceMissing("ctor") :- !BaseSourceLeaks("ctor").

// ---- this source --------------------------------------------------------------------
.decl ThisSourceLeaks()
ThisSourceLeaks() :-
  SinkCall(?invo, "<Main: void sinkObj(java.lang.Object)>", _),
  Instruction_Method(?invo, "<Main$Request: void validate()>"),
  ThisVar("<Main$Request: void validate()>", ?this),
  TaintTest_Leaks("this", "sink", ?invo, ?this).

.decl Taint_FAIL_ThisSourceMissing(?msg:symbol)
.output Taint_FAIL_ThisSourceMissing
Taint_FAIL_ThisSourceMissing("sinkObj(this) in validate() did not leak from this") :-
  !ThisSourceLeaks().

// ---- negatives for the caller-side positions -----------------------------------------
// The *Neg sinks are fed only by non-source values and must never leak.
.decl Taint_FAIL_CallerSideNegLeaks(?invo:symbol, ?from:symbol)
.output Taint_FAIL_CallerSideNegLeaks
Taint_FAIL_CallerSideNegLeaks(?invo, ?from) :-
  ( SinkCall(?invo, "<Main: void sinkBytesNeg(byte[])>", _) ;
    SinkCall(?invo, "<Main: void sinkObjNeg(java.lang.Object)>", _) ),
  LeakAt(?from, ?invo).

// ---- element of a filled buffer -------------------------------------------------------
// After read(buf), buf[0] carries taint into sinkByte: the tainted byte[] value
// in buf feeds the existing tainted-array load rule, which mints a byte-typed
// value into the loaded element.
.decl Taint_FAIL_FilledElementMissing(?invo:symbol)
.output Taint_FAIL_FilledElementMissing
Taint_FAIL_FilledElementMissing(?invo) :-
  SinkCall(?invo, "<Main: void sinkByte(byte)>", _), !LeakAt("arg", ?invo).

// ---- field source -------------------------------------------------------------------
// Mock half: a sink whose actual is loaded from a source field must leak under
// "field" with the field signature as the source -- for the static field with no
// store, the instance field assigned in the constructor, and the instance field
// never assigned at all.
.decl SinkFedByField(?invo:symbol, ?field:symbol)
SinkFedByField(?invo, ?field) :-
  SinkCall(?invo, _, ?actual),
  ( LoadStaticField(?field, ?actual, _) ; LoadInstanceField(_, ?field, ?actual, _) ).

.decl Taint_FAIL_FieldSourceMissing(?invo:symbol, ?field:symbol)
.output Taint_FAIL_FieldSourceMissing
Taint_FAIL_FieldSourceMissing(?invo, ?field) :-
  SinkFedByField(?invo, ?field),
  TaintSourceField(_, ?field),
  !TaintTest_Leaks("field", "sink", ?invo, ?field).

// Mark half: the array stored into Settings.data is passed to sinkBytes through an
// alias that never goes through the field, so only a mark on the real array
// object can produce this leak (the field is never loaded, so the mock cannot).
.decl FieldMarkLeaks()
FieldMarkLeaks() :-
  SinkCall(?invo, "<Main: void sinkBytes(byte[])>", _),
  TaintTest_Leaks("field", "sink", ?invo, "<Main$Settings: byte[] data>").

.decl Taint_FAIL_FieldMarkMissing(?msg:symbol)
.output Taint_FAIL_FieldMarkMissing
Taint_FAIL_FieldMarkMissing("sinkBytes(data) did not leak from the marked contents of Settings.data") :-
  !FieldMarkLeaks().

// Negative: a sink fed from a non-source field never leaks.
.decl Taint_FAIL_FieldNegLeaks(?invo:symbol, ?from:symbol)
.output Taint_FAIL_FieldNegLeaks
Taint_FAIL_FieldNegLeaks(?invo, ?from) :-
  SinkFedByField(?invo, "<Main$Settings: java.lang.String safe>"),
  LeakAt(?from, ?invo).

// ---- type source --------------------------------------------------------------------
// Every sinkObj call whose actual is a fresh Token or AdminToken allocation must
// leak under "type" with the type Main$Token as the source (the subtype case
// checks that the source covers subtypes). Ticket feeds only sinkObjNeg, which
// Taint_FAIL_CallerSideNegLeaks already requires to never leak.
.decl SinkFedByAllocOf(?invo:symbol, ?type:symbol)
SinkFedByAllocOf(?invo, ?type) :-
  SinkCall(?invo, "<Main: void sinkObj(java.lang.Object)>", ?actual),
  AssignHeapAllocation(?heap, ?actual, _),
  HeapAllocation_Type(?heap, ?type).

.decl Taint_FAIL_TypeSourceMissing(?invo:symbol, ?type:symbol)
.output Taint_FAIL_TypeSourceMissing
Taint_FAIL_TypeSourceMissing(?invo, ?type) :-
  SinkFedByAllocOf(?invo, ?type),
  ( ?type = "Main$Token" ; ?type = "Main$AdminToken" ),
  !TaintTest_Leaks("type", "sink", ?invo, "Main$Token").

// Mock half: Main$Session is never allocated, so a Session can reach a sink only
// as a stand-in placed at an entry position of the type. Each of the three entry
// positions must produce a leak under "type" with Main$Session as the source:
// the formal of serve(Session) (the sinkObj call inside serve), the static field
// CURRENT (a sinkObj fed by a load of it), and the result of the body-less
// openSession() (a sinkObj fed by that call). The first check guards the premise.
.decl Taint_FAIL_TypeMockMissing(?msg:symbol)
.output Taint_FAIL_TypeMockMissing
Taint_FAIL_TypeMockMissing("premise broken: Main$Session is allocated") :-
  HeapAllocation_Type(?heap, "Main$Session"),
  AssignHeapAllocation(?heap, _, _).
Taint_FAIL_TypeMockMissing("formal entry position") :-
  SinkCall(?invo, "<Main: void sinkObj(java.lang.Object)>", _),
  Instruction_Method(?invo, "<Main: void serve(Main$Session)>"),
  !TaintTest_Leaks("type", "sink", ?invo, "Main$Session").
Taint_FAIL_TypeMockMissing("field entry position") :-
  SinkFedByField(?invo, "<Main: Main$Session CURRENT>"),
  !TaintTest_Leaks("type", "sink", ?invo, "Main$Session").
Taint_FAIL_TypeMockMissing("body-less method result entry position") :-
  SinkFedBy(?invo, "<Main: Main$Session openSession()>"),
  !TaintTest_Leaks("type", "sink", ?invo, "Main$Session").
