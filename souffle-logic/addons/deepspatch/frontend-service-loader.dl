// ============================================================================
// deepspatch/frontend-service-loader.dl -- the java.util.ServiceLoader front-end.
//
// Registry: META-INF/services/<I> (plus spring.factories and
// META-INF/spring/*.imports), from the ServiceProvider(iface, provider) facts that
// fact generation emits (BasicJavaSupport.writeServiceProviders). FULLY AUTOMATIC:
// no hand-authored registry or seed facts.
// Calls: reached ServiceLoader.load / loadInstalled calls, and API-compatible
// reimplementations, whose Class argument reifies the interface.
// Feeds DispatchProduct(iface, iface, provider) and DispatchCall(.., iface, ..)
// to deepspatch/dispatch-backend.dl.
//
// Reflection-independent: the requested interface is recovered from the base
// fact ClassHeap_InstanceType (the type reified by an `I.class` literal), which
// fact generation always emits -- NOT from the reflection-gated ReifiedClass
// relation. So this fires on a plain analysis with no reflection flag. (It still
// only handles a *literal* Class argument; a Class.forName(...) result flowing to
// the load call would need reflection's string modelling. The coarse tier still
// applies.)
// ============================================================================

// Concrete, instantiable providers (drop abstract / interface registrations,
// which cannot be the run-time provider object).
.decl DispatchableProvider(?iface:symbol, ?provider:ReferenceType)
DispatchableProvider(?iface, ?provider) :-
  ServiceProvider(?iface, ?provider),
  isClassType(?provider),
  !ClassModifier("abstract", ?provider).

// The registry: each provider, used through its service interface. Real SPI
// loading is often string-keyed and routed through custom finders (javax.xml
// FactoryFinder, per-project ObjectFactory.newInstance(String),
// Class.forName(name)) that no call-site pattern can match; the back-end's
// coarse tier covers those through the interface.
DispatchProduct(?iface, ?iface, ?provider) :-
  DispatchableProvider(?iface, ?provider).

// Service-loader factory methods: load(Class[,ClassLoader]) whose result iterates
// the providers of the requested interface. The standard JDK loader, plus
// API-compatible reimplementations that honour the META-INF/services contract.
// Extend this relation to teach deepspatch a new loader implementation.
.decl ServiceLoadMethod(?method:Method)
// (a) The standard JDK ServiceLoader entry points (public platform API -- these are
// standard signatures, NOT benchmark-specific class names).
ServiceLoadMethod("<java.util.ServiceLoader: java.util.ServiceLoader load(java.lang.Class)>").
ServiceLoadMethod("<java.util.ServiceLoader: java.util.ServiceLoader load(java.lang.Class,java.lang.ClassLoader)>").
ServiceLoadMethod("<java.util.ServiceLoader: java.util.ServiceLoader loadInstalled(java.lang.Class)>").

// (b) GENERAL detection of ServiceLoader REIMPLEMENTATIONS -- no hardcoded class
// names. Many programs (especially ones predating java.util.ServiceLoader, Java 6)
// ship their own loader that follows the same contract: read the resource path
// "META-INF/services/<interface>" and reflectively instantiate the listed classes.
// Any method that (i) uses a "META-INF/services/..." string constant in its body and
// (ii) takes a java.lang.Class as its first parameter is such a loader for that Class
// -- structurally identified, so it generalizes to any reimplementation. Methods that
// instead take a String class-name (e.g. a FactoryFinder/ObjectFactory) are NOT matched
// here; those are string-keyed and covered by the coarse tier.
ServiceLoadMethod(?method) :-
  AssignHeapAllocation(?heap, _, ?method),
  isStringConstant(?heap),
  match("META-INF/services/.*", ?heap),
  FormalParam(0, ?method, ?param),
  Var_Type(?param, "java.lang.Class").

// A reached service-load call: recover the requested interface from the Class
// argument's points-to set and capture the result variable and its static type.
// The interface is read off the base fact ClassHeap_InstanceType -- the type that
// the argument's `I.class` heap value reifies -- so no reflection support is
// needed (the class heap flows to the argument through ordinary points-to).
.decl ServiceLoadCall(?ctx:mainAnalysis.configuration.Context, ?ret:Var, ?iface:ReferenceType, ?retType:Type)
ServiceLoadCall(?ctx, ?ret, ?iface, ?retType) :-
  ServiceLoadMethod(?method),
  mainAnalysis.ReachableContext(?ctx, ?inMethod),
  Instruction_Method(?invo, ?inMethod),
  MethodInvocation_Method(?invo, ?method),
  ActualParam(0, ?invo, ?clsArg),
  mainAnalysis.VarPointsTo(_, ?clsVal, ?ctx, ?clsArg),
  ClassHeap_InstanceType(?clsVal, ?iface),
  AssignReturnValue(?invo, ?ret),
  Var_Type(?ret, ?retType).

// A loader's result is a collection of providers: hand the back-end only the
// Iterable- and Iterator-typed results (the shapes a loader returns).
DispatchCall(?ctx, ?ret, ?iface, ?retType) :-
  ServiceLoadCall(?ctx, ?ret, ?iface, ?retType),
  ( DispatchIterableReturn(?retType) ; DispatchIteratorReturn(?retType) ).
